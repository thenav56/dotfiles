profile: moderate
exclude_paths:
  - .cache/
  - .ansible/
skip_list:
  - role-name
  # Style preferences; the existing names were carried verbatim from the
  # pre-refactor playbooks and rewording them is churn without payoff.
  - name[casing]
  # start_services is shared across roles by design (plan section 6) so
  # the no-role-prefix lint doesn't apply.
  - var-naming[no-role-prefix]
warn_list:
  - experimental
  - fqcn[keyword]
