#!/usr/bin/env python3
"""agent-usage-publish - publish a coding agent's plan usage to herdr and, for Claude, to a file.

    agent-usage-publish claude   # stdin: Claude Code statusline JSON (claude-statusline)
    agent-usage-publish codex    # stdin: Codex hook JSON (config/codex/hooks.json: SessionStart, Stop)
    agent-usage-publish claude-switch <email> <terminal>...   # from `claude-as set-default`

Sets the `agent.usage` label on this herdr terminal ($HC_TERMINAL_ID), or for
Codex, whose hooks run in a daemon outside any terminal, on every live Codex
terminal on this machine:

    {"app": "claude", "acct": "<key>", "h5": 12, "h5r": <epoch s>, "wk": 45, "wkr": <epoch s>, "at": <epoch s>}

acct keys the account: the email for Claude, "codex:<ChatGPT account id>" for
Codex, which also carries its login's "email" when auth.json's id token is
that account. h5/wk: 5-hour and weekly used %, h5r/wkr: when each resets (absent when
the agent didn't report that window). herdr-app's agents sidebar
(config/herdr-app/mods/agents-nav) shows the newest report per account next to
each machine name. Labels sync from remote machines too.

Writes only when the numbers change, or every REFRESH seconds so `at` says how
fresh they are. Claude sets the label only inside a herdr terminal.

Claude also writes, for every session inside herdr or not, the live file sink
$XDG_RUNTIME_DIR/claude-usages/live/<email>.json (tmpfs, dirs 0700, file 0600,
atomic replace) so other tools read each account's usage without API calls:

    {"acct": "<email>", "h5": 12, "h5r": <epoch s>, "wk": 45, "wkr": <epoch s>, "at": <epoch s>}

`at` is the time of the write. It is rewritten when this session reports numbers
that are new to it and differ from the file, or when the file holds the same
numbers and is LIVE_REFRESH seconds old. A session repeating numbers it already
reported leaves a differing file alone: another session wrote newer ones.
Skipped when XDG_RUNTIME_DIR is unset or not writable.

Silent and exits 0 on any problem: it must never hurt the status line or the
agent's turn.
"""

from __future__ import annotations

import base64
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime

LABEL = "agent.usage"
REFRESH = 300
LIVE_REFRESH = 60
TAIL = 512 * 1024  # How far back to look in a Codex transcript for its last rate limits.


def window(pct, resets_at, key: str) -> dict:
    if not isinstance(pct, (int, float)):
        return {}
    out = {key: round(pct)}
    if isinstance(resets_at, (int, float)):
        out[key + "r"] = int(resets_at)
    return out


# --- Claude Code -------------------------------------------------------------


def claude_account(state: dict) -> str | None:
    """The account's email, looked up on every render: `claude-as set-default` flips
    the `default` symlink under running sessions, so the path alone says nothing.
    claude-as names account dirs by email; otherwise .claude.json says, cached
    until that file changes (it can be large)."""
    d = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    name = os.path.basename(os.path.realpath(d))
    if "@" in name:
        return name
    path = os.path.join(d, ".claude.json") if os.environ.get("CLAUDE_CONFIG_DIR") else os.path.expanduser("~/.claude.json")
    try:
        key = f"{os.path.realpath(path)}:{os.path.getmtime(path)}"
        if state.get("acct_key") == key and state.get("acct"):
            return state["acct"]
        with open(path, encoding="utf-8") as f:
            acct = json.load(f).get("oauthAccount", {}).get("emailAddress")
        state.update(acct_key=key, acct=acct)
        return acct
    except Exception:
        return None


def claude(data: dict, state: dict) -> dict | None:
    limits = data.get("rate_limits") or {}
    five, week = limits.get("five_hour") or {}, limits.get("seven_day") or {}
    usage = {**window(five.get("used_percentage"), five.get("resets_at"), "h5"),
             **window(week.get("used_percentage"), week.get("resets_at"), "wk")}
    acct = claude_account(state)
    if not usage or not acct:
        return None
    return {"app": "claude", "acct": acct, **usage}


def stale_after_switch(prev: dict | None, usage: dict) -> bool:
    """Right after the account changes under a running session, its rate limits are
    still the old account's until its next API request: same numbers, new account."""
    if not prev or prev.get("acct") == usage["acct"]:
        return False
    return {k: v for k, v in prev.items() if k != "acct"} == {k: v for k, v in usage.items() if k != "acct"}


# --- Codex -------------------------------------------------------------------


def recent_rollouts(n: int = 5) -> list[str]:
    """This machine's most recently written Codex transcripts, newest first."""
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    paths = glob.glob(os.path.join(home, "sessions", "*", "*", "*", "*.jsonl"))
    return sorted(paths, key=os.path.getmtime, reverse=True)[:n]


def codex_email(account_id: str) -> str | None:
    """The login's email, from the id token's claims in auth.json, only when that
    login is this account. Only the email claim is read; tokens go nowhere."""
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    try:
        with open(os.path.join(home, "auth.json"), encoding="utf-8") as f:
            token = json.load(f)["tokens"]["id_token"]
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    except Exception:
        return None
    if (claims.get("https://api.openai.com/auth") or {}).get("chatgpt_account_id") != account_id:
        return None
    return claims.get("email") or (claims.get("https://api.openai.com/profile") or {}).get("email")


def codex(data: dict, state: dict) -> dict | None:
    """The newest rate limits in a rollout transcript (token_count events): the
    session's own, else (a new session has none yet, and is itself the newest
    transcript) the machine's newest other transcript that has some."""
    own = data.get("transcript_path")
    usage = codex_from(own)
    for path in [] if usage else recent_rollouts():
        if path != own and (usage := codex_from(path)):
            break
    if usage and usage["acct"].startswith("codex:"):
        # Remembered per account so auth.json is read once, not every turn.
        emails = state.setdefault("emails", {})
        if usage["acct"] not in emails:
            emails[usage["acct"]] = codex_email(usage["acct"].removeprefix("codex:"))
        if emails[usage["acct"]]:
            usage["email"] = emails[usage["acct"]]
    return usage


def codex_from(path: str | None) -> dict | None:
    if not path or not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        head = f.readline()
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - TAIL))
        tail = f.read().splitlines()
    limits = None
    for line in reversed(tail):
        if b'"rate_limits"' not in line:
            continue
        try:
            rl = json.loads(line).get("payload", {}).get("rate_limits")
        except Exception:
            continue
        if rl and rl.get("limit_id", "codex") == "codex":
            limits = rl
            break
    if not limits:
        return None
    usage = {}
    # By window length, not position: primary is 5h and secondary weekly today.
    for w in (limits.get("primary"), limits.get("secondary")):
        minutes = (w or {}).get("window_minutes") or 0
        key = "h5" if 0 < minutes <= 360 else "wk" if minutes >= 1440 else None
        if key:
            usage.update(window(w.get("used_percent"), w.get("resets_at"), key))
    if not usage:
        return None
    # The ChatGPT account from the session's first line, so auth.json stays unread.
    acct = "codex"
    try:
        meta = json.loads(head).get("payload", {})
        if meta.get("creator_account_id"):
            acct = f"codex:{meta['creator_account_id']}"
    except Exception:
        pass
    return {"app": "codex", "acct": acct, **usage}


# -----------------------------------------------------------------------------


HC = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")


def codex_terminals() -> list[str]:
    """Live Codex terminals on this machine. Codex runs hooks in its shared app-server
    daemon, which has no $HC_TERMINAL_ID; its sessions here share one login
    (~/.codex), so they all get the same usage."""
    done = subprocess.run([HC, "ls", "--json"], capture_output=True, timeout=5)
    listed = json.loads(done.stdout or b"[]")
    listed = listed if isinstance(listed, list) else listed.get("terminals", [])
    return [t["address"] for t in listed if t.get("agent") == "codex" and t.get("state") == "live" and "/" not in t["address"]]


def state_dir() -> str:
    return os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()


def live_dir() -> str | None:
    """$XDG_RUNTIME_DIR/claude-usages/live, created 0700, or None without a writable
    XDG_RUNTIME_DIR."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isdir(base) or not os.access(base, os.W_OK | os.X_OK):
        return None
    d = base
    for part in ("claude-usages", "live"):
        d = os.path.join(d, part)
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
    return d


def publish_live(usage: dict, state: dict, now: int) -> None:
    """Writes the Claude usage file sink (see the module docstring)."""
    new_here = usage != state.get("live")
    state["live"] = usage
    acct = usage["acct"]
    if "/" in acct or acct.startswith("."):
        return
    d = live_dir()
    if not d:
        return
    path = os.path.join(d, f"{acct}.json")
    numbers = {k: v for k, v in usage.items() if k != "app"}
    try:
        with open(path, encoding="utf-8") as f:
            cur = json.load(f)
    except Exception:
        cur = None
    if isinstance(cur, dict) and {k: v for k, v in cur.items() if k != "at"} == numbers:
        at = cur.get("at")
        if isinstance(at, (int, float)) and 0 <= now - at < LIVE_REFRESH:
            return
    elif isinstance(cur, dict) and not new_here:
        return
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".live-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({**numbers, "at": now}, f, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        os.unlink(tmp)
        raise


def known_claude_usage(email: str) -> dict | None:
    """The newest usage this machine has seen for a Claude account: what any session
    here last published for it, or ccstatusline's own cache (it asks the usage API
    per OAuth token and records which email each token is)."""
    best = None

    def offer(u: dict | None) -> None:
        nonlocal best
        if u and u.get("acct") == email and u.get("at", 0) > (best or {}).get("at", -1):
            best = u

    for path in glob.glob(os.path.join(state_dir(), "agent-usage-*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                for s in json.load(f).get("sent", {}).values():
                    offer({**s["usage"], "at": s["at"]})
        except Exception:
            continue

    cache = os.path.expanduser("~/.cache/ccstatusline")
    for path in glob.glob(os.path.join(cache, "usage-*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                c = json.load(f)
            with open(os.path.join(cache, f"account-email-{c['tokenHash']}.json"), encoding="utf-8") as f:
                if json.load(f).get("email") != email:
                    continue
            u = {"app": "claude", "acct": email}
            for key, pct, reset in (("h5", "sessionUsage", "sessionResetAt"), ("wk", "weeklyUsage", "weeklyResetAt")):
                when = datetime.fromisoformat(c[reset]).timestamp() if c.get(reset) else None
                u.update(window(c.get(pct), when, key))
            offer({**u, "at": int(os.path.getmtime(path))})
        except Exception:
            continue
    return best


def claude_switch(email: str, terms: list[str]) -> None:
    """`claude-as set-default` moved these terminals' sessions to `email`: show that
    account's newest known usage at once, or nothing rather than the old account's.
    Each session's own report takes over after its next request (stale_after_switch
    holds off its old numbers until then)."""
    u = known_claude_usage(email)
    value = json.dumps(u, separators=(",", ":")) if u else ""
    for t in terms:
        subprocess.run([HC, "label", t, f"{LABEL}={value}"], capture_output=True, timeout=5)


def main() -> None:
    app = sys.argv[1] if len(sys.argv) > 1 else ""
    if app == "claude-switch" and len(sys.argv) > 3:
        claude_switch(sys.argv[2], sys.argv[3:])
        return
    if app not in ("claude", "codex"):
        return
    term = os.environ.get("HC_TERMINAL_ID")
    raw = sys.stdin.read()
    data = json.loads(raw) if raw.strip() else {}

    # Claude: state per herdr terminal, else per session. Codex: one per machine,
    # remembering what each terminal got.
    if app == "codex":
        key = "codex"
    elif term:
        key = term.replace("/", "_")
    else:
        sid = "".join(c for c in str(data.get("session_id") or "") if c.isalnum() or c == "-")
        key = f"s-{sid}" if sid else None
    state_path = os.path.join(state_dir(), f"agent-usage-{key}.json") if key else None
    try:
        with open(state_path, encoding="utf-8") as f:
            state = json.load(f)
    except Exception:
        state = {}
    before = json.dumps(state, sort_keys=True)

    def save() -> None:
        if not state_path or json.dumps(state, sort_keys=True) == before:
            return
        tmp = f"{state_path}.{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.replace(tmp, state_path)

    usage = (claude if app == "claude" else codex)(data, state)
    if not usage:
        return
    now = int(time.time())
    sent = state.get("sent", {})
    if app == "claude":
        prev = sent.get(term, {}).get("usage") if term else state.get("live")
        if stale_after_switch(prev, usage):
            return
        try:
            publish_live(usage, state, now)
        except Exception:
            pass
        if not term:
            save()
            return
    targets = [term] if app == "claude" else codex_terminals()
    due = [t for t in targets if sent.get(t, {}).get("usage") != usage or now - sent[t].get("at", 0) >= REFRESH]
    if due:
        label = json.dumps({**usage, "at": now}, separators=(",", ":"))
        for t in due:
            done = subprocess.run([HC, "label", t, f"{LABEL}={label}"], capture_output=True, timeout=5)
            if done.returncode == 0:
                sent[t] = {"usage": usage, "at": now}
        # Forget terminals that are gone.
        state["sent"] = {t: s for t, s in sent.items() if t in targets}
    save()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
