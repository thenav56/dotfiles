#!/usr/bin/env python3
"""rex-pane-close - close a Rex pane, asking first when something is running in it.

Rex counterpart of the herdr pane-close mod. Rex's pane.close/client.close
close without asking, so:

  - a bare shell at its prompt (foreground process is a shell) closes at once;
  - anything else (an agent, nvim, a long command) opens a small floating
    prompt pane: Enter closes the pane, Esc (or any other key) cancels.

Fails closed: if the pane's process can't be read, nothing is closed.

Usage: rex-pane-close [-S HOST] [-s SESSION] [BLOCK]   (defaults: $REX_SESSION, $REX_BLOCK)

-S HOST: the pane is on another Rex server (a `rex hosts` label). The Mac app
runs config actions on its own server even for remote panes, so init.lua
passes ctx.server here. The prompt pane runs on the pane's machine as plain
/bin/sh with that machine's rex, so remote hosts need nothing from dotfiles.
Bound in config/rex/init.lua to cmd+w (same key as herdr's pane-close).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys

# rex.exec runs with the server's PATH, which may not include rex itself.
REX_FALLBACKS = [os.path.expanduser(p) for p in (
    "~/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/"
    "Rex Server.app/Contents/MacOS/rex",
    "~/.local/bin/rex",
)]
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "ksh", "tcsh", "csh", "nu", "xonsh", "login"}
# [x, y, w, h] as fractions of the window.
PROMPT_BOUNDS = [0.3, 0.4, 0.4, 0.14]

# Runs in the prompt pane, on the machine that owns the pane: $1 session,
# $2 block, $3 program name. Enter/y closes the pane, anything else cancels.
PROMPT_SH = r'''
rex=$(command -v rex)
for p in "$HOME/.local/bin/rex" \
  "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"; do
  [ -n "$rex" ] && break
  [ -x "$p" ] && rex=$p
done
printf '\n  \033[1m%s\033[0m is still running in this pane.\n\n  \033[1mEnter\033[0m close    \033[1mEsc\033[0m cancel' "$3"
old=$(stty -g); stty raw -echo
key=$(dd bs=1 count=1 2>/dev/null)
stty "$old"
case "$key" in
  "$(printf '\r')"|y|Y)
    "$rex" api call block.close "{\"session_id\":\"$1\",\"block_id\":\"$2\"}" >/dev/null ;;
  *) "$rex" focus -s "$1" "$2" >/dev/null 2>&1 ;;
esac
exit 0
'''

SERVER: list[str] = []
REX_STATE = os.path.expanduser("~/Library/Application Support/rex")


def die(msg: str) -> None:
    print(f"rex-pane-close: {msg}", file=sys.stderr)
    sys.exit(1)


def rex_bin() -> str:
    found = shutil.which("rex")
    if found:
        return found
    for p in REX_FALLBACKS:
        if os.path.exists(p):
            return p
    die("rex not found")
    raise AssertionError


def server_args(host: str) -> list[str]:
    """`rex -S` args for HOST (label or id). A plain label makes rex open a new
    ssh connection per call (~0.7s); the Mac app already keeps a tunnel socket
    per host, named sha256(endpoint NUL remote-socket)[:16], so use that when
    it exists (~0.1s). Rex internals: falls back to the label on any mismatch."""
    try:
        out = subprocess.run([rex_bin(), "hosts", "--json"], capture_output=True,
                             text=True, timeout=5).stdout
        hosts = [h["host"] for h in json.loads(out).get("hosts", [])]
        endpoints = next(h.get("endpoints", []) for h in hosts if host in (h.get("label"), h.get("id")))
        with open(os.path.join(REX_STATE, "host-endpoints.json")) as f:
            remote = json.load(f).get("ssh_sockets", {})
        for ep in endpoints:
            if ep in remote:
                key = hashlib.sha256(f"{ep}\0{remote[ep]}".encode()).hexdigest()[:16]
                sock = os.path.join(REX_STATE, "ssh", key + ".sock")
                if os.path.exists(sock):
                    return ["-S", "unix://" + sock]
    except (OSError, ValueError, KeyError, StopIteration, subprocess.SubprocessError):
        pass
    return ["-S", host]


def rex(*args: str, env: dict | None = None) -> str:
    proc = subprocess.run(
        [rex_bin(), *SERVER, *args], capture_output=True, text=True, timeout=15,
        env={**os.environ, **(env or {})},
    )
    if proc.returncode != 0:
        die(f"rex {args[0]}: {(proc.stderr or proc.stdout).strip()}")
    return proc.stdout


def window_of(session: str, block: str) -> dict:
    """Inspect the window holding `block` (REX_BLOCK isn't honoured with -S)."""
    blocks = json.loads(rex("block", "ls", "-s", session, "--json")).get("blocks", [])
    wid = next((b.get("window_id") for b in blocks if b.get("block_id") == block), None)
    if not wid:
        die("pane is not in a window")
    return json.loads(rex("window", "inspect", wid, "-s", session, "--json"))


def close_block(session: str, block: str) -> None:
    rex("api", "call", "block.close", json.dumps({"session_id": session, "block_id": block}))


def foreground(session: str, block: str) -> str:
    info = json.loads(rex("block", "call", "-s", session, "-b", block, "process"))
    fg = info.get("foreground") or info.get("child") or {}
    name = fg.get("name")
    if not name:
        die("can't tell what is running in the pane")
    return name


def ask(session: str, block: str) -> None:
    name = foreground(session, block)
    if name in SHELLS:
        close_block(session, block)
        return
    win = window_of(session, block)
    req = {
        "session_id": session,
        "window_id": win["window_id"],
        "bounds": PROMPT_BOUNDS,
        "focus": True,
        "layout": {"block": {
            "flavor": "com.superlogical.terminal.shell",
            "label": "Close pane?",
            "options": {
                "shell": "none",
                "command": ["/bin/sh", "-c", PROMPT_SH, "sh", session, block, name],
            },
        }},
    }
    rex("api", "call", "session.new_layer", json.dumps(req))


def main() -> None:
    ap = argparse.ArgumentParser(description="Close a Rex pane, asking if it is busy.")
    ap.add_argument("-S", "--server", default="", help="Rex host label (rex hosts)")
    ap.add_argument("-s", "--session", default=os.environ.get("REX_SESSION", ""))
    ap.add_argument("block", nargs="?", default=os.environ.get("REX_BLOCK", ""))
    a = ap.parse_args()
    if a.server:
        SERVER[:] = server_args(a.server)
    if not a.session or not a.block:
        die("need a session and block (args or REX_SESSION/REX_BLOCK)")
    ask(a.session, a.block)


if __name__ == "__main__":
    main()
