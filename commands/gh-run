#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Trigger a GitHub Actions workflow and follow its run — or just follow the latest.

Usage:
  gh-run <workflow>                # trigger on current branch, then watch + view
  gh-run <workflow> -b <branch>    # trigger on a specific branch
  gh-run <workflow> --last         # don't trigger; watch + view the latest run
  gh-run -r <run-id>               # don't trigger; watch + view a specific run id
  gh-run --list                    # list workflow files in this repo

<workflow> is a workflow file basename (e.g. helm-publish.yaml); shell <TAB>
completion suggests the files under .github/workflows/.
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn

POLL_INTERVAL = 2  # seconds between run-list polls
APPEAR_TIMEOUT = 90  # max seconds to wait for the triggered run to show up
GH_TIMEOUT = 60  # max seconds for a single non-streaming gh/git call
NOTIFY_TIMEOUT = 5  # notify-send blocks while D-Bus tries to activate a daemon
APP_NAME = "GH Action"


def eprint(*a: object) -> None:
    print(*a, file=sys.stderr, flush=True)


def run(
    cmd: list[str],
    *,
    capture: bool = False,
    check: bool = True,
    timeout: float | None = None,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        # Never block forever on a captured call; streamed calls run unbounded.
        timeout=timeout if timeout is not None else (GH_TIMEOUT if capture else None),
    )


def notify(title: str, body: str, *, urgency: str = "normal") -> None:
    """Best-effort desktop notification.

    kitty's own channel goes first: it works over SSH and without a D-Bus
    notification daemon (notify-send fails there with GDBus NameHasNoOwner, or
    blocks while trying to activate one). notify-send is only the fallback for
    when kitten is missing or fails. Exit status only — no output parsing.
    """
    candidates = [
        ["kitten", "notify", f"--app-name={APP_NAME}", f"--urgency={urgency}", title, body],
        ["notify-send", f"--app-name={APP_NAME}", f"--urgency={urgency}", title, body],
    ]
    for cmd in candidates:
        if shutil.which(cmd[0]) is None:
            continue
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=NOTIFY_TIMEOUT)
        except (subprocess.TimeoutExpired, OSError):
            continue
        if proc.returncode == 0:
            return
    eprint(f"⚠️  could not send notification: {title} — {body}")


def die(title: str, body: str, code: int = 1) -> NoReturn:
    """Notify + exit; never wait around for input or another poll."""
    eprint(f"❌ {title} — {body}")
    # Keep the popup to one line; the full message already went to stderr.
    notify(f"❌ {title}", body.splitlines()[0] if body else "failed", urgency="critical")
    sys.exit(code)


def repo_root() -> Path | None:
    try:
        out = run(["git", "rev-parse", "--show-toplevel"], capture=True).stdout.strip()
        return Path(out) if out else None
    except subprocess.CalledProcessError:
        return None


def current_branch() -> str:
    proc = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture=True, check=False)
    branch = proc.stdout.strip()
    if proc.returncode != 0 or not branch:
        die("gh-run", (proc.stderr or "not a git repository").strip(), 1)
    return branch


def workflow_files() -> list[str]:
    root = repo_root()
    if not root:
        return []
    wf = root / ".github" / "workflows"
    if not wf.is_dir():
        return []
    return sorted(p.name for p in wf.iterdir() if p.suffix in (".yaml", ".yml"))


def list_runs(workflow: str, branch: str, limit: int = 20) -> list[dict]:
    proc = run(
        [
            "gh", "run", "list",
            "--workflow", workflow,
            "--branch", branch,
            "--limit", str(limit),
            "--json", "databaseId,status,event,createdAt,displayTitle,url",
        ],
        capture=True,
        check=False,
    )
    if proc.returncode != 0:
        die(f"{workflow} - {branch}", (proc.stderr or "gh run list failed").strip(), proc.returncode)
    return json.loads(proc.stdout or "[]")


def run_meta(run_id: int) -> tuple[str, str]:
    """Return (workflowName, headBranch) for a run id — used for labels only."""
    proc = run(
        ["gh", "run", "view", str(run_id), "--json", "workflowName,headBranch,displayTitle,url"],
        capture=True,
        check=False,
    )
    if proc.returncode != 0:
        die(f"run {run_id}", (proc.stderr or "gh run view failed").strip(), proc.returncode)
    meta = json.loads(proc.stdout or "{}")
    eprint(f"following run {run_id} — {meta.get('displayTitle', '')}")
    eprint(f"   {meta.get('url', '')}")
    return meta.get("workflowName") or str(run_id), meta.get("headBranch") or "?"


def latest_run_id(workflow: str, branch: str) -> int | None:
    runs = list_runs(workflow, branch, limit=1)
    return runs[0]["databaseId"] if runs else None


def wait_for_new_run(workflow: str, branch: str, seen: set[int]) -> int:
    """Poll until a run whose id is not in `seen` appears; return its id."""
    deadline = time.monotonic() + APPEAR_TIMEOUT
    eprint(f"⏳ waiting for the triggered run to appear ({workflow} @ {branch})...")
    while time.monotonic() < deadline:
        for r in list_runs(workflow, branch):
            if r["databaseId"] not in seen:
                eprint(f"✅ run {r['databaseId']} — {r.get('displayTitle', '')}")
                eprint(f"   {r.get('url', '')}")
                return r["databaseId"]
        time.sleep(POLL_INTERVAL)
    die(f"{workflow} - {branch}", f"timed out after {APPEAR_TIMEOUT}s waiting for the new run")


def follow(run_id: int, workflow: str, branch: str) -> int:
    # `gh run watch` streams progress; --exit-status returns the run's conclusion.
    # Let gh render both the progress and the summary — no output parsing here.
    watch = run(["gh", "run", "watch", str(run_id), "--exit-status"], check=False)
    ok = watch.returncode == 0
    notify(
        f"{'✅' if ok else '❌'} {workflow} - {branch}",
        "success" if ok else f"failed (exit {watch.returncode})",
        urgency="normal" if ok else "critical",
    )
    run(["gh", "run", "view", str(run_id)], check=False, timeout=GH_TIMEOUT)
    return watch.returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="gh-run",
        description="Trigger a GitHub Actions workflow and follow its run.",
    )
    parser.add_argument("workflow", nargs="?", help="workflow file basename, e.g. helm-publish.yaml")
    parser.add_argument("-b", "--branch", help="branch to run on (default: current branch)")
    parser.add_argument(
        "-l", "--last", action="store_true",
        help="don't trigger; just watch + view the latest run",
    )
    parser.add_argument(
        "-r", "--run-id", type=int, metavar="ID",
        help="don't trigger; watch + view this run id (any workflow/branch)",
    )
    parser.add_argument("--list", action="store_true", help="list workflow files and exit")
    args = parser.parse_args()

    if args.list:
        files = workflow_files()
        if not files:
            eprint("no workflow files found under .github/workflows/")
            return 1
        print("\n".join(files))
        return 0

    if args.run_id is not None:
        if args.workflow:
            parser.error("--run-id takes the run itself; drop the workflow argument")
        return follow(args.run_id, *run_meta(args.run_id))

    if not args.workflow:
        parser.error("workflow is required (see --list, or pass --run-id)")

    branch = args.branch or current_branch()

    if args.last:
        run_id = latest_run_id(args.workflow, branch)
        if run_id is None:
            die(f"{args.workflow} - {branch}", "no runs found")
        eprint(f"following latest run {run_id} ({args.workflow} @ {branch})")
        return follow(run_id, args.workflow, branch)

    # Trigger, then follow the run that did not exist beforehand.
    seen = {r["databaseId"] for r in list_runs(args.workflow, branch)}
    eprint(f"🚀 triggering {args.workflow} @ {branch}")
    trig = run(
        ["gh", "workflow", "run", args.workflow, "--ref", branch],
        check=False,
        timeout=GH_TIMEOUT,
    )
    if trig.returncode != 0:
        die(f"{args.workflow} - {branch}", "gh workflow run failed", trig.returncode)

    run_id = wait_for_new_run(args.workflow, branch, seen)
    return follow(run_id, args.workflow, branch)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        eprint("\ninterrupted")
        sys.exit(130)
    except subprocess.TimeoutExpired as exc:
        die("gh-run", f"timed out: {' '.join(exc.cmd) if isinstance(exc.cmd, list) else exc.cmd}")
    except Exception as exc:  # never hang or dump a bare traceback at the user
        die("gh-run", f"{type(exc).__name__}: {exc}")
