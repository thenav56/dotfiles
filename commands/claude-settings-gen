#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""claude-settings-gen - generate Claude Code settings.json from layered sources.

Claude Code reads a single `settings.json`. We treat that file as GENERATED
output, merged from three layers in order (later wins):

  settings.base.json   git-tracked, shared base (REQUIRED source)
  settings.local.json  private, machine-local override (OPTIONAL; gitignored,
                       usually a symlink into an encrypted store that may be
                       absent at launch)
  settings.host.json   private, per-host override (OPTIONAL; gitignored,
                       usually a symlink like settings.local.json)

The merged result is written atomically to `settings.json`. Never hand-edit
`settings.json` -- it gets overwritten on every run.

Config dir resolution matches skills-cli: $CLAUDE_CONFIG_DIR or ~/.claude.

Merge semantics (each layer is merged onto the result so far; the overlay wins):
  * dicts   -> recursively deep-merged.
  * arrays  -> REPLACED by default. Special form: an overlay value of
               {"__append": [...]} on a key whose current value is a list
               appends those items to that list instead of replacing it.
               With no list to append to (key absent, or not a list), the
               marker resolves to a plain list of its items.
  * scalars -> overlay replaces current.
Because CC's `hooks` is {EventName: [...]}, an overlay per-event array fully
replaces the earlier one (arrays replace).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

BASE_NAME = "settings.base.json"
LOCAL_NAME = "settings.local.json"
HOST_NAME = "settings.host.json"
OUT_NAME = "settings.json"


def config_dir() -> Path:
    """Resolve the Claude config dir (same convention as skills-cli)."""
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(env).expanduser() if env else Path.home() / ".claude"


def deep_merge(base, local):
    """Merge `local` onto `base`, local wins. See module docstring for rules."""
    # Both dicts -> recurse key by key.
    if isinstance(base, dict) and isinstance(local, dict):
        merged = dict(base)
        for key, lval in local.items():
            if key in merged:
                merged[key] = deep_merge(merged[key], lval)
            else:
                merged[key] = resolve_appends(lval)
        return merged

    # Append form: base is a list and local is {"__append": [...]}.
    if (
        isinstance(base, list)
        and isinstance(local, dict)
        and set(local.keys()) == {"__append"}
        and isinstance(local["__append"], list)
    ):
        return base + local["__append"]

    # Everything else (arrays without __append, scalars, type mismatch): local wins.
    return resolve_appends(local)


def resolve_appends(value):
    """Turn every {"__append": [...]} in `value` into a plain list.

    Used for overlay values with nothing to merge onto, so no literal
    __append marker reaches settings.json.
    """
    if isinstance(value, dict):
        if set(value.keys()) == {"__append"} and isinstance(value["__append"], list):
            return [resolve_appends(item) for item in value["__append"]]
        return {key: resolve_appends(val) for key, val in value.items()}
    if isinstance(value, list):
        return [resolve_appends(item) for item in value]
    return value


def load_overlay(path: Path, label: str):
    """Load an optional overlay layer; return its dict, or None if unusable."""
    # A broken symlink, missing file, or invalid JSON must NOT crash -- the
    # encrypted mount may simply be absent at launch. exists() follows
    # symlinks, so a broken symlink reads as missing here.
    if not path.exists():
        return None
    try:
        loaded = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        print(f"⚠️ note: ignoring {label} {path}: {exc}", file=sys.stderr)
        return None
    # Only an object can be merged as a layer; report honestly
    # (don't claim "merged" while silently dropping a non-object layer).
    if not isinstance(loaded, dict):
        print(f"⚠️ note: ignoring {label} {path}: top-level value is "
              f"{type(loaded).__name__}, expected an object", file=sys.stderr)
        return None
    return loaded


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="claude-settings-gen",
        description=(
            "Generate Claude Code settings.json by merging settings.base.json "
            "(required), settings.local.json and settings.host.json (optional, "
            "later wins)."
        ),
    )
    parser.parse_args()

    cfg = config_dir()
    base_path = cfg / BASE_NAME
    local_path = cfg / LOCAL_NAME
    host_path = cfg / HOST_NAME
    out_path = cfg / OUT_NAME

    # Base is required -- refuse to write garbage if it is missing/invalid.
    if not base_path.exists():
        print(f"⛔ error: required base not found: {base_path}", file=sys.stderr)
        return 1
    try:
        base = json.loads(base_path.read_text())
    except (OSError, ValueError) as exc:
        print(f"⛔ error: cannot read base {base_path}: {exc}", file=sys.stderr)
        return 1

    # Overlays are optional and merged in order: base -> local -> host.
    result = base
    merged = ["base"]
    for label, path in (("local", local_path), ("host", host_path)):
        overlay = load_overlay(path, label)
        if overlay is not None:
            result = deep_merge(result, overlay)
            merged.append(label)
    note = "base only" if len(merged) == 1 else "merged " + " + ".join(merged)

    # Atomic write: temp file in the same dir, then os.replace.
    text = json.dumps(result, indent=2) + "\n"
    fd, tmp = tempfile.mkstemp(dir=str(cfg), prefix=".settings.", suffix=".json")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        os.replace(tmp, out_path)
    except BaseException:
        # Best-effort cleanup of the temp file on any failure.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

    print(f"✅ {note} -> {out_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
