#!/usr/bin/env bash
# claude-custom - regenerate Claude Code settings, then launch the real claude.
#
# settings.json is a generated file (see commands/claude-settings-gen). This
# wrapper regenerates it from settings.base.json + settings.local.json, then
# launches the real claude binary. Aliased as `claude` in config/zshrc.
set -euo pipefail

# Resolve our own path through any symlinks so the sibling generator is found
# even when this script is invoked via a symlink on PATH.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$dir/$source"
done
script_dir="$(cd -P "$(dirname "$source")" && pwd)"

# Regenerate settings.json. Never block launch on a generation error.
if ! "$script_dir/claude-settings-gen"; then
  echo "⛔ claude-custom: warning: settings generation failed; launching anyway" >&2
fi

# Launch the real claude binary. (`exec command claude` does NOT work: exec
# needs an external program, but `command` is a shell builtin.) Enumerate the
# claude binaries on PATH and pick the first that isn't this wrapper, so it
# keeps working even if the wrapper is ever placed on PATH as `claude`.
real_claude=""
while IFS= read -r cand; do
  [ "$cand" = "$source" ] && continue
  real_claude="$cand"
  break
done < <(type -ap claude 2>/dev/null || true)

if [ -z "$real_claude" ]; then
  echo "⛔ claude-custom: error: no 'claude' binary found on PATH" >&2
  exit 127
fi
exec "$real_claude" "$@"
