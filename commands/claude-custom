#!/usr/bin/env bash
# claude-custom - regenerate Claude Code settings, then launch the real claude.
#
# settings.json is a generated file (see commands/claude-settings-gen). This
# wrapper regenerates it from settings.base.json + settings.local.json, then
# launches the real claude binary. Aliased as `claude` in config/zshrc.
set -euo pipefail

# Resolve our own path through any symlinks so the sibling generator is found
# even when this script is invoked via a symlink on PATH.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$dir/$source"
done
script_dir="$(cd -P "$(dirname "$source")" && pwd)"

# Regenerate settings.json. Never block launch on a generation error.
if ! "$script_dir/claude-settings-gen"; then
  echo "claude-custom: warning: settings generation failed; launching anyway" >&2
fi

# `command claude` resolves the real binary on PATH (the claude() shell
# function is not defined in this non-interactive script, so no recursion).
exec command claude "$@"
