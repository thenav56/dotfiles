HELP = __doc__


def main(argv: list[str]) -> int:
    if "--" in argv:
        idx = argv.index("--")
        left, passthrough = argv[:idx], argv[idx + 1:]
    else:
        left, passthrough = argv, []

    if "--help" in left or "-h" in left:
        print(HELP)
        return 0
    if left and left[0] == "remind":
        return _remind_main(left[1:], passthrough)
    if left and left[0] == "resume":
        return _resume_main(left[1:], passthrough)
    if left and left[0] == "backlog":
        return _backlog_main(left[1:], passthrough)
    if left and left[0] == "accounts":
        extra = [a for a in left[1:] if a != "--json"]
        if extra or passthrough:
            console.print(f"[red]accounts takes only --json, got:[/red] "
                          f"{' '.join(extra + passthrough)}")
            return 2
        return cmd_accounts("--json" in left[1:])
    if left and left[0] == "get-default":
        if left[1:] or passthrough:
            console.print("[red]get-default takes no arguments[/red]")
            return 2
        return cmd_get_default()
    if left and left[0] == "search":
        return _search_main(left[1:], passthrough)
    if left and left[0] in ("protect", "unprotect"):
        return _protect_main(left[1:], passthrough, unprotect=left[0] == "unprotect")
    if left and left[0] == "set-default":
        if len(left) != 2 or passthrough:
            console.print("[red]usage:[/red] claude-as set-default <selector>")
            return 2
        return cmd_set_default(left[1])

    flags = [a for a in left if a.startswith("-")]
    if flags:
        console.print(f"[red]unknown option(s):[/red] {' '.join(flags)}")
        console.print("Put claude arguments after [bold]--[/bold] "
                      "(e.g. [bold]claude-as -- --resume[/bold]).")
        return 2
    positionals = [a for a in left if not a.startswith("-")]
    if len(positionals) > 1:
        console.print(f"[red]expected at most one account selector, got:[/red] "
                      f"{' '.join(positionals)}")
        return 2

    if positionals and positionals[0] == DEFAULT_NAME:
        return launch_default(passthrough)
    users = load_users()
    if positionals:
        email = resolve_selector(positionals[0], users)
    else:
        email = pick_account(users)

    launch(email, passthrough)  # execs; does not return
    return 0


def launch_default(passthrough: list[str]) -> int:
    """Launch with CLAUDE_CONFIG_DIR = the unresolved `default` symlink path."""
    try:
        email = current_default()
    except DefaultError as exc:
        console.print(f"[red]error:[/red] {exc}")
        return 1
    if email is None:
        console.print(f"[red]no default account set[/red] — run "
                      f"[bold]claude-as set-default <selector>[/bold] first")
        return 1
    if not (accounts_root() / email).is_dir():
        console.print(f"[red]default points at a missing dir:[/red] "
                      f"{accounts_root() / email} — run [bold]claude-as set-default[/bold]")
        return 1
    launch(email, passthrough, config_dir=default_link())  # execs; does not return
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
