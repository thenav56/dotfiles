def _loads(line: bytes):
    """Parse one JSONL line; None for malformed or non-dict lines."""
    try:
        rec = json.loads(line)
    except ValueError:  # JSONDecodeError and UnicodeDecodeError
        return None
    return rec if isinstance(rec, dict) else None


def _last_of_type(data: bytes, rtype: str):
    """Last record of `rtype`, found by scanning backwards for its marker."""
    marker = f'"type":"{rtype}"'.encode()
    pos = len(data)
    while True:
        i = data.rfind(marker, 0, pos)
        if i < 0:
            return None
        start = data.rfind(b"\n", 0, i) + 1
        end = data.find(b"\n", i)
        rec = _loads(data[start:end if end >= 0 else len(data)])
        if rec is not None and rec.get("type") == rtype:
            return rec
        pos = start


def _text_of(content) -> str | None:
    """A message's text: the string itself, or the first text block of a list."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                text = block.get("text")
                return text if isinstance(text, str) else None
    return None


def _oneline(text: str, limit: int) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _is_real_user(rec: dict) -> bool:
    return (rec.get("type") == "user" and not rec.get("isMeta")
            and not rec.get("isSidechain") and not rec.get("isCompactSummary"))


def parse_session(path: Path) -> dict:
    """Index row for one transcript (query-time fields are added by
    session_index)."""
    data = path.read_bytes()
    lines = data.split(b"\n")

    first_prompt = ""
    for line in lines:
        if b'"type":"user"' not in line:
            continue
        rec = _loads(line)
        if rec is None or not _is_real_user(rec):
            continue
        msg = rec.get("message")
        text = _text_of(msg.get("content")) if isinstance(msg, dict) else None
        if text and text.strip() and not text.lstrip().startswith("<"):
            first_prompt = _oneline(text, FIRST_PROMPT_MAX)
            break

    cwd, branch = "", ""
    for line in reversed(lines):
        if b'"cwd":"' not in line:
            continue
        rec = _loads(line)
        if rec is not None and rec.get("type") in _CWD_TYPES and rec.get("cwd"):
            cwd, branch = str(rec["cwd"]), str(rec.get("gitBranch") or "")
            break

    def field(rtype: str, key: str) -> str:
        rec = _last_of_type(data, rtype)
        val = rec.get(key) if rec else None
        return val if isinstance(val, str) else ""

    custom = field("custom-title", "customTitle")
    ai = field("ai-title", "aiTitle")
    last_prompt = _oneline(field("last-prompt", "lastPrompt"), FIRST_PROMPT_MAX)
    st = path.stat()
    return {
        "id": path.stem,
        "title": _oneline(custom or ai or first_prompt or last_prompt, FIRST_PROMPT_MAX),
        "custom_title": custom,
        "ai_title": ai,
        "cwd": cwd,
        "branch": branch,
        "mtime": st.st_mtime,
        "first_prompt": first_prompt,
        "last_prompt": last_prompt,
        "path": str(path),
    }


def _load_cache(cache_path: Path) -> dict:
    try:
        with open(cache_path) as fh:
            cache = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(cache, dict) or cache.get("version") != SEARCH_CACHE_VERSION:
        return {}
    files = cache.get("files")
    return files if isinstance(files, dict) else {}


def _save_cache(cache_path: Path, files: dict) -> None:
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = cache_path.with_name(f"{cache_path.name}.tmp-{os.getpid()}")
        with open(tmp, "w") as fh:
            json.dump({"version": SEARCH_CACHE_VERSION, "files": files}, fh)
        os.replace(tmp, cache_path)
    except OSError as exc:
        print(f"warning: cannot write session cache {cache_path}: {exc}",
              file=sys.stderr)


# --- protected store ---------------------------------------------------------

def _now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def load_protected(*, strict: bool = False) -> dict:
    """PROTECTED_FILE as {"sessions": {...}, "projects": {...},
    "unprotected": [...]} (unprotected pruned, newest first).

    A missing file is empty. An unreadable one warns and reads as empty, or
    exits when `strict` (callers that write it back must not wipe it).
    """
    try:
        with open(PROTECTED_FILE) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError) as exc:
        if strict:
            console.print(f"[red]cannot read {PROTECTED_FILE}:[/red] {exc}")
            raise SystemExit(1)
        print(f"warning: cannot read {PROTECTED_FILE}: {exc}", file=sys.stderr)
        data = {}
    if not isinstance(data, dict):
        data = {}
    store = {}
    for key in ("sessions", "projects"):
        section = data.get(key)
        store[key] = {k: (v if isinstance(v, dict) else {})
                      for k, v in section.items()} if isinstance(section, dict) else {}
    entries = data.get("unprotected")
    store["unprotected"] = _prune_unprotected(
        [e for e in entries if _entry_key(e) is not None]
        if isinstance(entries, list) else [])
    return store


def _iso_ts(value) -> float | None:
    """Epoch seconds of an ISO timestamp (naive = local time); None if invalid."""
    if not isinstance(value, str):
        return None
    try:
        dt = datetime.fromisoformat(value)
    except ValueError:
        return None
    return (dt if dt.tzinfo else dt.astimezone()).timestamp()


def _entry_key(entry) -> tuple[str, str] | None:
    """("session", id) or ("project", path) of an unprotected entry."""
    if not isinstance(entry, dict):
        return None
    kind = entry.get("kind")
    key = entry.get({"session": "id", "project": "path"}.get(kind, ""))
    return (kind, key) if isinstance(key, str) and key else None


def _prune_unprotected(entries: list[dict], now: float | None = None) -> list[dict]:
    """Newest first, at most UNPROTECTED_MAX, none older than UNPROTECTED_DAYS."""
    cutoff = (now if now is not None else time.time()) - UNPROTECTED_DAYS * 86400
    dated = [(ts, e) for e in entries
             if (ts := _iso_ts(e.get("removed"))) is not None and ts >= cutoff]
    dated.sort(key=lambda pair: pair[0], reverse=True)
    return [e for _, e in dated[:UNPROTECTED_MAX]]


def _pop_unprotected(store: dict, kind: str, key: str) -> dict | None:
    """Remove every unprotected entry for (kind, key); return the newest."""
    hits = [e for e in store["unprotected"] if _entry_key(e) == (kind, key)]
    store["unprotected"] = [e for e in store["unprotected"]
                            if _entry_key(e) != (kind, key)]
    return hits[0] if hits else None


def _record_unprotect(store: dict, kind: str, key: str, flag: dict) -> None:
    """Remember a dropped session/project flag (its note and added date)."""
    _pop_unprotected(store, kind, key)
    entry = {"kind": kind, "id" if kind == "session" else "path": key,
             "note": flag.get("note"), "added": flag.get("added"),
             "removed": _now_iso()}
    store["unprotected"] = _prune_unprotected([entry, *store["unprotected"]])


def _set_flag(store: dict, kind: str, key: str, note: str | None) -> dict:
    """Flag a session/project. A newly flagged one with a remembered
    unprotected entry gets that entry's note and added date back unless
    `note` is given; its entries leave the unprotected list either way."""
    section = store["sessions" if kind == "session" else "projects"]
    prev = _pop_unprotected(store, kind, key)
    flag = section.get(key)
    if flag is None:
        if prev is not None and note is None:
            flag = {"note": prev.get("note"), "added": prev.get("added") or _now_iso()}
        else:
            flag = {"note": None, "added": _now_iso()}
        section[key] = flag
    if note is not None:
        flag["note"] = note
    return flag


def undo_entry(session_id: str, cwd: str, store: dict) -> dict | None:
    """The unprotected entry that undo would restore for a session: its own
    session entry, else the newest project entry covering cwd."""
    project = None
    for entry in store["unprotected"]:  # newest first
        kind, key = _entry_key(entry)
        if kind == "session" and key == session_id:
            return entry
        if kind == "project" and project is None and _under(cwd, key):
            project = entry
    return project


def _write_json_atomic(path: Path, data) -> None:
    """Write JSON to a tmp file next to `path`, then rename it over `path`."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp-{os.getpid()}")
    try:
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def save_protected(store: dict) -> None:
    _write_json_atomic(PROTECTED_FILE, store)


def _under(cwd: str, root: str) -> bool:
    """cwd is root or inside it (`/a/b` covers `/a/b/c`, not `/a/bc`)."""
    if not cwd:
        return False
    root = root.rstrip("/")
    return cwd == (root or "/") or cwd.startswith(root + "/")


def _project_rule(cwd: str, store: dict) -> str | None:
    """Most specific protected project path covering cwd."""
    hits = [p for p in store["projects"] if _under(cwd, p)]
    return max(hits, key=len) if hits else None


def protection(session_id: str, cwd: str, store: dict) -> tuple[bool, str | None]:
    """(protected, note) from a session flag or a covering project rule."""
    entry = store["sessions"].get(session_id)
    rule = _project_rule(cwd, store)
    if entry is None and rule is None:
        return False, None
    note = (entry or {}).get("note") or (
        store["projects"][rule].get("note") if rule else None)
    return True, note


# --- active sessions ---------------------------------------------------------

def _proc_start(proc_dir: Path) -> str | None:
    """starttime (field 22) from /proc/<pid>/stat."""
    try:
        return (proc_dir / "stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def _pid_alive(pid: int, proc_start, proc_root: Path) -> bool:
    """pid runs and is the process the session file was written by: starttime
    equals procStart, or (no procStart) its cmdline mentions claude."""
    proc_dir = proc_root / str(pid)
    if proc_start not in (None, ""):
        return _proc_start(proc_dir) == str(proc_start)
    try:
        return b"claude" in (proc_dir / "cmdline").read_bytes()
    except OSError:
        return False


def active_sessions(sessions_dir: Path | None = None,
                    proc_root: Path | None = None) -> dict[str, dict]:
    """sessionId -> {pid, status, cwd, name} for running claude processes."""
    sessions_dir = sessions_dir or CLAUDE_HOME / "sessions"
    proc_root = proc_root or PROC_ROOT
    try:
        entries = list(os.scandir(sessions_dir))
    except OSError:
        return {}
    found: list[tuple[str, int, object, dict]] = []
    for entry in entries:
        stem, ext = os.path.splitext(entry.name)
        if ext != ".json" or not stem.isdigit():
            continue
        try:
            with open(entry.path) as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict):
            continue
        sid = data.get("sessionId")
        pid = data.get("pid")
        if not isinstance(sid, str) or not sid:
            continue
        if not isinstance(pid, int):
            pid = int(stem)
        found.append((sid, pid, data.get("procStart"), data))
    if IS_MAC:
        procs = _mac_procs({pid for _, pid, _, _ in found})
        alive = {pid for _, pid, start, _ in found
                 if _mac_pid_alive(pid, start, procs)}
    else:
        alive = {pid for _, pid, start, _ in found
                 if _pid_alive(pid, start, proc_root)}
    out: dict[str, dict] = {}
    for sid, pid, _, data in found:
        if pid not in alive:
            continue
        out[sid] = {"pid": pid, "status": str(data.get("status") or ""),
                    "cwd": str(data.get("cwd") or ""),
                    "name": str(data.get("name") or "")}
    return out


def _mac_procs(pids: set[int]) -> dict[int, tuple[str, str]]:
    """pid -> (lstart, command) for the running ones among `pids`, from one
    `ps` call. lstart is five words (`Tue Nov 17 15:18:41 2026`). Lists all
    processes: `ps -p` prints nothing at all when one pid is out of range."""
    if not pids:
        return {}
    out = {}
    for line in _ps(["-axo", "pid=,lstart=,command="]).splitlines():
        parts = line.split(None, 6)
        if len(parts) < 6 or not parts[0].isdigit() or int(parts[0]) not in pids:
            continue
        out[int(parts[0])] = (" ".join(parts[1:6]), parts[6] if len(parts) > 6 else "")
    return out


def _mac_pid_alive(pid: int, proc_start, procs: dict[int, tuple[str, str]]) -> bool:
    """macOS _pid_alive: claude records procStart as `ps -o lstart=` in UTC."""
    info = procs.get(pid)
    if info is None:
        return False
    if proc_start not in (None, ""):
        return " ".join(str(proc_start).split()) == info[0]
    return "claude" in info[1]


# --- index -------------------------------------------------------------------

def session_index(projects_dir: Path | None = None,
                  cache_path: Path | None = None,
                  store: dict | None = None) -> list[dict]:
    """All top-level sessions, newest first, reparsing only changed files.

    Archived transcripts whose live copy is gone are included with
    `live: False`; a session in both places is listed once, as live.
    """
    projects_dir = projects_dir or _projects_dir()
    cache_path = cache_path or SEARCH_CACHE
    old = _load_cache(cache_path)
    files: dict = {}
    live: dict[str, bool] = {}
    changed = False
    for base, is_live in ((projects_dir, True), (_archive_projects(), False)):
        for path in base.glob("*/*.jsonl"):
            key = str(path)
            try:
                st = path.stat()
            except OSError:
                continue
            live[key] = is_live
            sig = [st.st_mtime_ns, st.st_size]
            entry = old.get(key)
            if entry and entry.get("sig") == sig and isinstance(entry.get("row"), dict):
                files[key] = entry
                continue
            try:
                row = parse_session(path)
            except OSError:
                continue
            files[key] = {"sig": sig, "row": row}
            changed = True
    if changed or set(files) != set(old):
        _save_cache(cache_path, files)

    by_id: dict[str, dict] = {}
    for key, entry in files.items():
        row = dict(entry["row"])
        row["live"] = live[key]
        prev = by_id.get(row["id"])
        if prev is not None and (prev["live"] or not row["live"]):
            continue
        by_id[row["id"]] = row

    store = store if store is not None else load_protected()
    active = active_sessions()
    rows = list(by_id.values())
    for row in rows:
        row["cwd_exists"] = bool(row["cwd"]) and os.path.isdir(row["cwd"])
        row["protected"], row["note"] = protection(row["id"], row["cwd"], store)
        undo = None if row["protected"] else undo_entry(row["id"], row["cwd"], store)
        row["unprotected_at"] = undo["removed"] if undo else None
        act = active.get(row["id"])
        row["active"] = act is not None
        row["active_status"] = act["status"] if act else None
        row["active_pid"] = act["pid"] if act else None
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    return rows


def filter_view(rows: list[dict], view: str) -> list[dict]:
    if view == "active":
        return [r for r in rows if r["active"]]
    if view == "protected":
        return [r for r in rows if r["protected"]]
    if view == "unprotected":
        return sorted((r for r in rows if r["unprotected_at"]),
                      key=lambda r: _iso_ts(r["unprotected_at"]) or 0, reverse=True)
    return rows


def grep_sessions(pattern: str, projects_dir: Path | None = None) -> set[str] | None:
    """Paths of top-level transcripts (live and archived) containing `pattern`
    (case-insensitive, fixed string) via ripgrep. None when rg is missing."""
    roots = [p for p in (projects_dir or _projects_dir(), _archive_projects())
             if p.is_dir()]
    rg = shutil.which("rg")
    if not rg:
        return None
    if not roots:
        return set()
    proc = subprocess.run(
        [rg, "-l", "-i", "-F", "--no-ignore", "--hidden", "--max-depth", "2",
         "--glob", "*.jsonl", "-e", pattern, *map(str, roots)],
        capture_output=True, text=True,
    )
    return {line for line in proc.stdout.splitlines() if line}


# --- archive sync / restore --------------------------------------------------

def _copy_if_changed(src: Path, dst: Path) -> bool:
    """copy2 src -> dst (atomically) unless dst has the same size and mtime."""
    st = src.stat()
    try:
        dt = dst.stat()
        if dt.st_size == st.st_size and dt.st_mtime_ns == st.st_mtime_ns:
            return False
    except FileNotFoundError:
        pass
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(f".{dst.name}.tmp-{os.getpid()}")
    try:
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise
    return True


def _sync_tree(src: Path, dst: Path) -> int:
    """Copy new/changed regular files under src into dst; never deletes.
    Per-file failures warn on stderr. Returns the number of files copied."""
    n = 0
    for root, _dirs, names in os.walk(src):
        rel = Path(root).relative_to(src)
        for name in names:
            path = Path(root, name)
            if path.is_symlink() or not path.is_file():
                continue
            try:
                n += _copy_if_changed(path, dst / rel / name)
            except OSError as exc:
                print(f"warning: cannot copy {path}: {exc}", file=sys.stderr)
    return n


def _file_history_dirs() -> list[tuple[str, Path]]:
    """(account, file-history dir) for every real account dir, one per distinct
    resolved file-history dir."""
    home = find_home()
    if home is None:
        return []
    try:
        accts = sorted((home / "accounts").iterdir())
    except OSError:
        return []
    out, seen = [], set()
    for acct in accts:
        fh = acct / "file-history"
        if acct.is_symlink() or not fh.is_dir():
            continue
        real = fh.resolve()
        if real not in seen:
            seen.add(real)
            out.append((acct.name, fh))
    return out


def archive_session(transcript: Path, fh_dirs: list[tuple[str, Path]]) -> int:
    """Mirror one live session into PROTECTED_ARCHIVE; returns files copied."""
    sid = transcript.stem
    dst = _archive_projects() / transcript.parent.name
    n = 0
    try:
        n += _copy_if_changed(transcript, dst / transcript.name)
    except OSError as exc:
        print(f"warning: cannot archive {transcript}: {exc}", file=sys.stderr)
    session_dir = transcript.parent / sid
    if session_dir.is_dir():
        n += _sync_tree(session_dir, dst / sid)
    for acct, fh in fh_dirs:
        if (fh / sid).is_dir():
            n += _sync_tree(fh / sid, _archive_file_history() / acct / sid)
    return n


def sync_protected(rows: list[dict] | None = None,
                   store: dict | None = None) -> dict[str, int]:
    """Archive every protected session that still has a live transcript.

    Returns {id: files copied}. Unchanged files cost one stat each; with no
    protected sessions or projects nothing is scanned.
    """
    store = store if store is not None else load_protected()
    if not store["sessions"] and not store["projects"]:
        return {}
    if rows is None:
        rows = session_index(store=store)
    fh_dirs = _file_history_dirs()
    return {row["id"]: archive_session(Path(row["path"]), fh_dirs)
            for row in rows if row["live"] and row["protected"]}


def _sync_quietly(rows: list[dict] | None = None) -> None:
    """sync_protected once per process; failures only warn."""
    global _SYNCED
    if _SYNCED:
        return
    _SYNCED = True
    try:
        sync_protected(rows)
    except Exception as exc:  # never block a launch
        print(f"warning: protected-session sync failed: {exc}", file=sys.stderr)


def restore_session(row: dict, email: str | None) -> int:
    """Copy an archived session back into CLAUDE_HOME/projects, and its
    file-history into `email`'s account dir. Returns files copied."""
    src = Path(row["path"])
    sid = row["id"]
    dst = _projects_dir() / src.parent.name
    n = int(_copy_if_changed(src, dst / src.name))
    if (src.parent / sid).is_dir():
        n += _sync_tree(src.parent / sid, dst / sid)
    sources = [p for p in _archive_file_history().glob(f"*/{glob.escape(sid)}")
               if p.is_dir()]
    if sources and email is None:
        print("warning: no account to restore file-history into", file=sys.stderr)
    elif sources:
        target = accounts_root() / email / "file-history" / sid
        # The launching account's own copy is applied last so its files win.
        for path in sorted(sources, key=lambda p: p.parent.name == email):
            n += _sync_tree(path, target)
    return n


def _archived_paths(sid: str) -> list[Path]:
    pat = glob.escape(sid)
    return [*_archive_projects().glob(f"*/{pat}.jsonl"),
            *(p for p in _archive_projects().glob(f"*/{pat}") if p.is_dir()),
            *(p for p in _archive_file_history().glob(f"*/{pat}") if p.is_dir())]


def purge_archive(sid: str) -> int:
    """Delete a session's archived files; returns the number of paths removed."""
    paths = _archived_paths(sid)
    for path in paths:
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
        with contextlib.suppress(OSError):
            path.parent.rmdir()  # only when now empty
    return len(paths)


# --- rendering ---------------------------------------------------------------

def _age(mtime: float, now: float | None = None) -> str:
    secs = max(0, (now if now is not None else time.time()) - mtime)
    for unit, size in (("y", 365 * 86400), ("mo", 30 * 86400), ("d", 86400),
                       ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return f"{int(secs)}s"


def _tilde(path: str) -> str:
    home = str(Path.home())
    if path == home or path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def _fit(text: str, width: int) -> str:
    text = text.replace("\t", " ")
    return text.ljust(width) if len(text) <= width else text[:width - 1] + "…"


def _cells(text: str) -> int:
    """Terminal cell width (East Asian Wide/Fullwidth = 2)."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def _pad(text: str, width: int) -> str:
    return text + " " * max(0, width - _cells(text))


def _markers(row: dict) -> tuple[str, str, str, str]:
    """(active, protected, archived-only, missing-cwd) cells, each padded to a
    fixed width: `🟢status`, `📌` (or `↩` recently unprotected), `🗄`, `⚠`."""
    active = (_pad("🟢" + _fit(row["active_status"] or "?", STATUS_WIDTH).rstrip(),
                   2 + STATUS_WIDTH) if row["active"] else " " * (2 + STATUS_WIDTH))
    return (active,
            _pad("📌" if row["protected"] else "↩" if row["unprotected_at"] else "", 2),
            _pad("🗄" if not row["live"] else "", 1),
            _pad("⚠" if not row["cwd_exists"] else "", 1))


def _fzf_line(row: dict) -> str:
    """`id \\t age \\t markers \\t title \\t project \\t branch \\t search-text`.

    fzf never searches fields hidden by --with-nth, so the note, prompts and
    id are the last displayed field, dimmed; it usually falls past the right
    edge.
    """
    project = _tilde(row["cwd"]) or "?"
    if not row["cwd_exists"]:
        project = f"\x1b[31m{project}\x1b[0m"
    active, pin, archived, warn = _markers(row)
    markers = f"\x1b[32m{active}\x1b[0m{pin}{archived}\x1b[31m{warn}\x1b[0m"
    extra = _oneline(" | ".join(x for x in (row["note"] or "", row["first_prompt"],
                                            row["last_prompt"], row["id"]) if x), 600)
    return "\t".join([
        row["id"],
        _fit(_age(row["mtime"]), 4),
        markers,
        _fit(row["title"] or "(untitled)", 60),
        project,
        f"\x1b[36m{row['branch']}\x1b[0m" if row["branch"] else "",
        f"\x1b[2m{extra.replace(chr(9), ' ')}\x1b[0m",
    ])


def _self_cmd(*args: str) -> str:
    """Shell command running this script (absolute path, independent of PATH)."""
    return " ".join(shlex.quote(a) for a in
                    (sys.executable, str(Path(__file__).resolve()), *args))


def _reminders_prompt(back: str) -> str:
    return f"reminders (from {back})> "


def _fzf_command(query: str, pattern: str | None = None,
                 view: str = "all") -> list[str]:
    """fzf argv. Reloads call `search --rows`; the --grep pattern reaches them
    through $CLAUDE_AS_SEARCH_GREP so fzf never parses it. The current view is
    the prompt text before `>`; ctrl-s (next session view) and ctrl-r (into or
    out of the reminders view) print prompt, header, key and reload actions
    from `transform` shell snippets. The reminders view never applies --grep."""
    grep = f' --grep "${GREP_ENV}"' if pattern is not None else ""
    base = _self_cmd("search", "--rows")
    current = base + ' --view "${FZF_PROMPT%%>*}"' + grep
    reminders = base + " --view reminders"
    leave = (f"+change-header[{FZF_HEADER}]+rebind({SESSION_KEYS})"
             f"+unbind({REMIND_KEYS})")
    enter = (f"+change-header[{REMIND_HEADER}]+unbind({SESSION_KEYS})"
             f"+rebind({REMIND_KEYS})")
    to_view = (f'printf "change-prompt(%s> )%s+reload:%s --view %s%s" '
               f'"$v" {shlex.quote(leave)} {shlex.quote(base)} "$v" '
               f'{shlex.quote(grep)}')
    cycle = ('case "$FZF_PROMPT" in all*) v=active ;; active*) v=protected ;; '
             f'protected*) v=unprotected ;; *) v=all ;; esac; {to_view}')
    flip = ('case "$FZF_PROMPT" in '
            f'reminders*) v=${{FZF_PROMPT#*from }}; v=${{v%%)*}}; {to_view} ;; '
            f'*) printf "change-prompt[%s]%s+reload:%s" '
            f'"{_reminders_prompt("${FZF_PROMPT%%>*}")}" {shlex.quote(enter)} '
            f'{shlex.quote(reminders)} ;; esac')
    toggle = _self_cmd("protect", "--toggle") + " {1}"
    ask = _self_cmd("protect", "--ask-note") + " {1}"
    # {1} is `rem:<id>`; strip the prefix in the shell.
    rid = f'"${{r#{REMINDER_PREFIX}}}"'
    cancel = "r={1}; " + _self_cmd("remind", "rm") + f" {rid}"
    snooze = "r={1}; " + _self_cmd("remind", "snooze") + f" {rid} {REMIND_SNOOZE}"
    ack = "r={1}; " + _self_cmd("remind", "ack") + f" {rid}"
    in_reminders = view == "reminders"
    binds = [
        "ctrl-j:down",
        "ctrl-k:up",
        f"ctrl-s:transform:{cycle}",
        f"ctrl-p:track-current+execute-silent({toggle})+reload:{current}",
        f"ctrl-n:track-current+execute({ask})+reload:{current}",
        f"ctrl-r:transform:{flip}",
        f"ctrl-a:track-current+execute-silent({ack})+reload:{reminders}",
        f"ctrl-x:track-current+execute-silent({cancel})+reload:{reminders}",
        f"ctrl-z:track-current+execute-silent({snooze})+reload:{reminders}",
        f"start:unbind({SESSION_KEYS if in_reminders else REMIND_KEYS})",
    ]
    prompt = _reminders_prompt("all") if in_reminders else f"{view}> "
    header = REMIND_HEADER if in_reminders else FZF_HEADER
    preview = _self_cmd("search", "--preview") + " {1}"
    cmd = ["fzf", "--ansi", f"--prompt={prompt}", "--reverse", "--height=90%",
           "--delimiter=\t", "--with-nth=2..", "--accept-nth=1", "--id-nth=1",
           "--tabstop=1", "--no-sort", "--with-shell=sh -c",
           f"--header={header}", "--header-first", "--preview", preview,
           "--preview-window=right,50%,wrap"]
    for bind in binds:
        cmd += ["--bind", bind]
    if query:
        cmd.append(f"--query={query}")
    return cmd


def _print_list(rows: list[dict]) -> None:
    from rich.markup import escape

    for row in rows:
        project = escape(_tilde(row["cwd"]) or "?")
        if not row["cwd_exists"]:
            project = f"[red]{project}[/red]"
        active, pin, archived, warn = _markers(row)
        branch = f"  [cyan]{escape(row['branch'])}[/cyan]" if row["branch"] else ""
        console.print(
            f"{_age(row['mtime']):>4}  [dim]{row['id'][:8]}[/dim]  "
            f"[green]{escape(active)}[/green]{pin}{archived}[red]{warn}[/red] "
            f"{escape(_fit(row['title'] or '(untitled)', 60))}  {project}{branch}",
            highlight=False, soft_wrap=True)


def _due_cell(rem: dict, now: float | None = None) -> tuple[str, bool]:
    """(`MM-DD HH:MM in 3h`, red) for the reminders view: red when overdue;
    a missed reminder reads `MM-DD HH:MM MISSED`."""
    ts = _iso_ts(rem.get("due"))
    missed = _reminder_state(rem) == "missed"
    if ts is None:
        return _fit("MISSED" if missed else "?", 22), missed
    stamp = datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")
    if missed:
        return f"{stamp} {_fit('MISSED', 10)}", True
    now = now if now is not None else time.time()
    return f"{stamp} {_fit(_relative(ts, now), 10)}", ts <= now


def _reminder_cells(rem: dict) -> tuple[str, str, str]:
    """(note, session prefix or `-`, repo label) for the reminders view."""
    return (" ".join(str(rem.get("note") or "").split()),
            (rem.get("session_id") or "-")[:8],
            str(rem.get("repo_label") or rem.get("cwd") or "?"))


def _reminder_line(rem: dict, now: float | None = None) -> str:
    """`rem:<id> \t due \t id \t note \t session \t repo \t cwd` (the
    last field dimmed, for search)."""
    due, late = _due_cell(rem, now)
    note, session, repo = _reminder_cells(rem)
    return "\t".join([
        REMINDER_PREFIX + rem["id"],
        f"\x1b[31m{due}\x1b[0m" if late else due,
        f"\x1b[2m{_fit(rem['id'], 6)}\x1b[0m",
        _fit(note, 60),
        _fit(session, 8),
        f"\x1b[36m{repo}\x1b[0m",
        f"\x1b[2m{_tilde(str(rem.get('cwd') or ''))}\x1b[0m",
    ])


def _print_reminders(rems: list[dict]) -> None:
    from rich.markup import escape

    if not rems:
        console.print("no pending or missed reminders")
    now = time.time()
    for rem in rems:
        due, late = _due_cell(rem, now)
        note, session, repo = _reminder_cells(rem)
        console.print(
            f"{f'[red]{due}[/red]' if late else due}  [dim]{rem['id']}[/dim]  "
            f"{escape(_fit(note, 60))}  {session:<8}  [cyan]{escape(repo)}[/cyan]",
            highlight=False, soft_wrap=True)


def _find_session(session_id: str, projects_dir: Path | None = None) -> Path | None:
    """Live transcript, else the archived copy."""
    pat = f"*/{glob.escape(session_id)}.jsonl"
    for base in (projects_dir or _projects_dir(), _archive_projects()):
        path = next(iter(base.glob(pat)), None)
        if path is not None:
            return path
    return None


def cmd_search_preview(session_id: str, projects_dir: Path | None = None) -> int:
    """fzf preview: header fields, then the last few user/assistant texts."""
    path = _find_session(session_id, projects_dir)
    if path is None:
        print(f"session not found: {session_id}")
        return 1
    row = parse_session(path)
    exists = os.path.isdir(row["cwd"]) if row["cwd"] else False
    store = load_protected()
    protected, note = protection(row["id"], row["cwd"], store)
    act = active_sessions().get(row["id"])
    flags = []
    if act:
        flags.append(f"running pid {act['pid']} ({act['status'] or '?'})")
    if protected:
        flags.append("protected" + (f": {note}" if note else ""))
    else:
        undo = undo_entry(row["id"], row["cwd"], store)
        ts = _iso_ts(undo["removed"]) if undo else None
        if ts is not None:
            flags.append(f"unprotected {_age(ts)} ago (^p undo)")
    if not path.is_relative_to(projects_dir or _projects_dir()):
        flags.append("archived only")
    print(f"title:   {row['title'] or '(untitled)'}")
    print(f"id:      {row['id']}")
    print(f"cwd:     {_tilde(row['cwd'])}" + ("" if exists else "  (missing)"))
    print(f"branch:  {row['branch']}")
    print(f"active:  {time.strftime('%Y-%m-%d %H:%M', time.localtime(row['mtime']))}"
          f" ({_age(row['mtime'])} ago)")
    if flags:
        print(f"flags:   {' · '.join(flags)}")
    print(f"first:   {row['first_prompt']}")
    print()

    messages: list[str] = []
    for line in reversed(path.read_bytes().split(b"\n")):
        if b'"type":"user"' not in line and b'"type":"assistant"' not in line:
            continue
        rec = _loads(line)
        if rec is None or rec.get("isSidechain") or rec.get("isMeta"):
            continue
        rtype = rec.get("type")
        msg = rec.get("message")
        if rtype not in ("user", "assistant") or not isinstance(msg, dict):
            continue
        text = _text_of(msg.get("content"))
        if not text or not text.strip() or text.lstrip().startswith("<"):
            continue
        who = "you" if rtype == "user" else "claude"
        messages.append(f"[{who}] {_oneline(text, PREVIEW_MESSAGE_MAX)}")
        if len(messages) >= PREVIEW_MESSAGES:
            break
    for m in reversed(messages):
        print(m)
        print()
    return 0


def cmd_reminder_preview(rid: str) -> int:
    """fzf preview in the reminders view: the reminder, then its session."""
    rem = next((r for r in load_reminders() if r["id"] == rid), None)
    if rem is None:
        print(f"reminder not found: {rid}")
        return 1

    def when(key: str) -> str:
        ts = _iso_ts(rem.get(key))
        return f"{_local(ts)} ({_relative(ts)})" if ts is not None else "?"

    status = _reminder_state(rem)
    if rem.get("attempts"):
        status += f" ({rem['attempts']} failed send(s): {rem.get('last_error') or '?'})"
    sid = rem.get("session_id")
    print(f"note:    {rem.get('note') or ''}")
    print(f"due:     {when('due')}")
    print(f"created: {when('created')}")
    print(f"status:  {status}")
    if rem.get("fired_at"):
        print(f"fired:   {when('fired_at')}")
    if rem.get("acked_at"):
        print(f"acked:   {when('acked_at')} via {rem.get('acked_via') or '?'}")
    print(f"cwd:     {_tilde(str(rem.get('cwd') or '?'))}")
    print(f"repo:    {rem.get('repo_label') or '?'}")
    print(f"session: {sid or '-'}")
    if sid:
        print()
        print("─" * 40)
        cmd_search_preview(sid)
    return 0


def _reminder_haystack(rem: dict) -> str:
    return " ".join(str(rem.get(k) or "") for k in
                    ("id", "note", "session_id", "repo_label", "cwd")).lower()


_STATE_RANK = {"missed": 0, "pending": 1}


def reminders_by_due(show: str = "open") -> list[dict]:
    """Reminders for `show` ("open" = missed + pending, "missed", "all"):
    missed first, then pending, then the rest; soonest due first in each."""
    rems = load_reminders()
    if show == "open":
        rems = [r for r in rems if _reminder_state(r) in ("missed", "pending")]
    elif show == "missed":
        rems = [r for r in rems if _reminder_state(r) == "missed"]
    rems.sort(key=lambda r: (_STATE_RANK.get(_reminder_state(r), 2),
                             _iso_ts(r.get("due")) or 0.0))
    return rems


def reminder_json(rem: dict) -> dict:
    """The record with every ack field (None when unset) and its `state`."""
    return {**dict.fromkeys(ACK_FIELDS), **rem, "state": _reminder_state(rem)}


def _haystack(row: dict) -> str:
    return " ".join((row["title"], row["cwd"], row["branch"], row["first_prompt"],
                     row["last_prompt"], row["id"], row["note"] or "")).lower()


JSON_KEYS = ("id", "title", "custom_title", "ai_title", "cwd", "cwd_exists",
             "branch", "mtime", "first_prompt", "last_prompt", "path", "live",
             "protected", "note", "unprotected_at", "active", "active_status",
             "active_pid")


def cmd_search(*, selector: str | None, pattern: str | None, mode: str,
               query: str, passthrough: list[str], view: str = "all",
               force_resume: bool = False) -> int:
    """Find a session (fzf / --list / --json / --rows) and resume it in its
    cwd. The reminders view lists missed and pending reminders instead and
    resumes the picked reminder's session (which does not ack it)."""
    if view == "reminders":
        rems = reminders_by_due()
        if mode in ("list", "json") and query:
            words = query.lower().split()
            rems = [r for r in rems if all(w in _reminder_haystack(r) for w in words)]
        if mode == "json":
            print(json.dumps([reminder_json(r) for r in rems], indent=2))
            return 0
        if mode == "list":
            _print_reminders(rems)
            return 0
        now = time.time()
        lines = [_reminder_line(r, now) for r in rems]
        if mode == "rows":
            for line in lines:
                print(line)
            return 0
        _sync_quietly()
    else:
        rows = session_index()
        if mode != "rows":
            _sync_quietly(rows)
        if pattern is not None:
            hits = grep_sessions(pattern)
            if hits is None:
                console.print("[red]rg not found on PATH[/red] (needed for --grep)")
                return 1
            rows = [r for r in rows if r["path"] in hits]
        rows = filter_view(rows, view)

        if mode in ("list", "json") and query:
            words = query.lower().split()
            rows = [r for r in rows if all(w in _haystack(r) for w in words)]

        if mode == "json":
            print(json.dumps([{k: r[k] for k in JSON_KEYS} for r in rows], indent=2))
            return 0
        if mode == "list":
            _print_list(rows)
            return 0
        lines = [_fzf_line(r) for r in rows]
        if mode == "rows":
            for line in lines:
                print(line)
            return 0

    if not shutil.which("fzf"):
        console.print("[red]fzf not found on PATH[/red] — use "
                      "[bold]claude-as search --list[/bold] (or --json)")
        return 1
    if not lines:
        console.print("no pending or missed reminders" if view == "reminders"
                      else "no sessions found")
        return 0
    env = dict(os.environ)
    if pattern is not None:
        env[GREP_ENV] = pattern
    proc = subprocess.run(_fzf_command(query, pattern, view),
                          input="\n".join(lines),
                          stdout=subprocess.PIPE, text=True, env=env)
    chosen = proc.stdout.strip()
    if proc.returncode != 0 or not chosen:
        return 0
    if chosen.startswith(REMINDER_PREFIX):
        return resume_reminder(chosen[len(REMINDER_PREFIX):], selector=selector,
                               passthrough=passthrough, force_resume=force_resume)
    # Rows may have changed in fzf (protect toggles), so look the pick up fresh.
    row = next((r for r in session_index() if r["id"] == chosen), None)
    if row is None:
        return 0
    return resume_row(row, selector=selector, passthrough=passthrough,
                      force_resume=force_resume)


def resume_reminder(rid: str, *, selector: str | None, passthrough: list[str],
                    force_resume: bool = False) -> int:
    """Resume a reminder's session through resume_row. Without a session, or
    with one missing from the index, print its cwd and a `cd` hint; exit 1."""
    rem = next((r for r in load_reminders() if r["id"] == rid), None)
    if rem is None:
        console.print(f"[red]unknown reminder:[/red] {rid}")
        return 1
    sid = rem.get("session_id")
    row = next((r for r in session_index() if r["id"] == sid), None) if sid else None
    if row is not None:
        return resume_row(row, selector=selector, passthrough=passthrough,
                          force_resume=force_resume)
    why = f"session {sid} not in the session index" if sid else "no session"
    console.print(f"[yellow]reminder {rid}: {why}[/yellow]", highlight=False)
    cwd = rem.get("cwd")
    if cwd:
        console.print(f"cwd: {cwd}" + ("" if os.path.isdir(cwd) else "  (missing)"),
                      highlight=False)
        console.print(f"cd {shlex.quote(cwd)}", highlight=False)
    else:
        console.print("no cwd recorded", highlight=False)
    return 1


def resume_row(row: dict, *, selector: str | None, passthrough: list[str],
               force_resume: bool = False) -> int:
    """Resume one index row: refuse a running session, restore an archived-only
    one, cd into its dir, launch as `selector` or `default`."""
    if row["active"] and not force_resume:
        console.print(f"[yellow]already running:[/yellow] pid {row['active_pid']}, "
                      f"status {row['active_status'] or '?'}, cwd {row['cwd'] or '?'}"
                      f" — pass --force-resume to open it anyway")
        return 1
    email = resolve_selector(selector, load_users()) if selector is not None else None
    if not row["live"]:
        target = email
        if target is None:
            with contextlib.suppress(DefaultError):
                target = current_default()
        try:
            n = restore_session(row, target)
        except OSError as exc:
            console.print(f"[red]cannot restore {row['id']} from archive:[/red] {exc}")
            return 1
        console.print(f"[green]restored from archive[/green] {row['id']} "
                      f"({n} file(s))")

    if row["cwd_exists"]:
        os.chdir(row["cwd"])
    else:
        console.print(f"[yellow]warning:[/yellow] session dir "
                      f"{row['cwd'] or '(unknown)'} no longer exists — resuming "
                      f"from {os.getcwd()}")
    args = ["--resume", row["id"], *passthrough]
    if email is not None:
        launch(email, args)  # execs
        return 0
    return launch_default(args)


def _search_main(args: list[str], passthrough: list[str]) -> int:
    usage = ("[red]usage:[/red] claude-as search \\[--as <sel>] \\[--grep <pat>] "
             "\\[--view all|active|protected|unprotected|reminders] "
             "\\[--list|--json] "
             "\\[--force-resume] "
             "\\[query...] \\[-- <claude args>]")
    selector = pattern = preview = None
    view = "all"
    mode = "fzf"
    force_resume = False
    query: list[str] = []
    it = iter(args)
    for arg in it:
        if arg in ("--as", "--grep", "--preview", "--view"):
            val = next(it, None)
            if val is None:
                console.print(f"[red]{arg} needs a value[/red]")
                console.print(usage)
                return 2
            if arg == "--as":
                selector = val
            elif arg == "--grep":
                pattern = val
            elif arg == "--view":
                if val not in VIEWS:
                    console.print(f"[red]--view must be one of:[/red] {', '.join(VIEWS)}")
                    return 2
                view = val
            else:
                preview = val
        elif arg in ("--list", "--json", "--rows"):
            new = arg[2:]
            if mode not in ("fzf", new):
                console.print("[red]--list, --json and --rows are exclusive[/red]")
                return 2
            mode = new
        elif arg == "--force-resume":
            force_resume = True
        elif arg.startswith("-"):
            console.print(f"[red]unknown search option:[/red] {arg}")
            console.print(usage)
            return 2
        else:
            query.append(arg)
    if preview is not None:
        if preview.startswith(REMINDER_PREFIX):
            return cmd_reminder_preview(preview[len(REMINDER_PREFIX):])
        return cmd_search_preview(preview)
    if view == "reminders" and pattern is not None:
        console.print("[red]--grep does not apply to --view reminders[/red]")
        return 2
    if mode != "fzf" and (selector is not None or passthrough or force_resume):
        console.print(f"[red]--as / --force-resume / claude args only apply to the "
                      f"picker, not --{mode}[/red]")
        return 2
    return cmd_search(selector=selector, pattern=pattern, mode=mode,
                      query=" ".join(query), passthrough=passthrough, view=view,
                      force_resume=force_resume)


# --- protect / unprotect -----------------------------------------------------

def _resolve_session(prefix: str, ids) -> str:
    """Exact id, else the unique id starting with prefix. Exits 2 otherwise."""
    ids = set(ids)
    if prefix in ids:
        return prefix
    cands = sorted(i for i in ids if prefix and i.startswith(prefix))
    if len(cands) == 1:
        return cands[0]
    if cands:
        console.print(f"[red]ambiguous session prefix[/red] {prefix!r} matches:")
        for sid in cands:
            console.print(f"  {sid}")
    else:
        console.print(f"[red]unknown session:[/red] {prefix!r}")
    raise SystemExit(2)


def _abs_project(path: str) -> str:
    return os.path.realpath(os.path.expanduser(path))


def _report_sync(copied: dict[str, int], rows: list[dict]) -> None:
    titles = {r["id"]: r["title"] for r in rows}
    done = {sid: n for sid, n in copied.items() if n}
    for sid, n in done.items():
        console.print(f"[green]archived[/green] {sid[:8]}  {n} file(s)  "
                      f"{titles.get(sid) or '(untitled)'}", highlight=False)
    if not done:
        console.print("[dim]archive up to date[/dim]")
    console.print(f"[dim]archive: {PROTECTED_ARCHIVE}[/dim]")


def cmd_protect(target: str | None, *, project: str | None, note: str | None) -> int:
    """Flag a session (id or unique prefix) or a project, then sync the archive."""
    store = load_protected(strict=True)
    if project is not None:
        path = _abs_project(project)
        _set_flag(store, "project", path, note)
        save_protected(store)
        console.print(f"[green]protected project[/green] {path} (and everything under it)")
    else:
        sid = _resolve_session(target, (r["id"] for r in session_index(store=store)))
        _set_flag(store, "session", sid, note)
        save_protected(store)
        console.print(f"[green]protected[/green] {sid}")
    rows = session_index(store=store)
    _report_sync(sync_protected(rows, store), rows)
    return 0


def _restore_entry(store: dict, entry: dict) -> int:
    """Re-flag an unprotected entry with its original note and added date,
    save, then sync the archive."""
    kind, key = _entry_key(entry)
    flag = _set_flag(store, kind, key, None)
    save_protected(store)
    what = f"project {key}" if kind == "project" else key
    note = f'  note "{flag["note"]}"' if flag.get("note") else ""
    console.print(f"[green]restored protection[/green] {what}{note}  "
                  f"(protected since {flag.get('added') or '?'})", highlight=False)
    rows = session_index(store=store)
    if kind == "session" and key not in {r["id"] for r in rows}:
        console.print(f"[yellow]warning:[/yellow] no live or archived transcript "
                      f"of {key[:8]} is left; only the flag was restored")
    _report_sync(sync_protected(rows, store), rows)
    return 0


def cmd_protect_undo(target: str | None) -> int:
    """Re-protect the newest unprotected entry, or the one matching `target`
    (session id / unique prefix, or project path)."""
    store = load_protected(strict=True)
    entries = store["unprotected"]
    if not entries:
        console.print("[yellow]nothing to undo[/yellow] (no recently unprotected "
                      "sessions or projects)")
        return 1
    if target is None:
        return _restore_entry(store, entries[0])
    sessions = [e for e in entries if _entry_key(e)[0] == "session"
                and _entry_key(e)[1].startswith(target)]
    exact = [e for e in sessions if e["id"] == target]
    hits = exact or sessions
    if len(hits) > 1:
        console.print(f"[red]ambiguous session prefix[/red] {target!r} matches:")
        for e in hits:
            console.print(f"  {e['id']}")
        return 2
    if not hits:
        path = _abs_project(target)
        hits = [e for e in entries if _entry_key(e) == ("project", path)]
    if not hits:
        console.print(f"[yellow]nothing to undo for[/yellow] {target!r}")
        return 1
    return _restore_entry(store, hits[0])


def _kept_or_purged(sids: list[str], rows: dict[str, dict], purge: bool) -> None:
    for sid in sids:
        if purge:
            n = purge_archive(sid)
            gone = sid in rows and not rows[sid]["live"]
            if n:
                console.print(f"[yellow]purged[/yellow] archived copy of {sid[:8]}"
                              + (" — it was the only copy" if gone else ""))
        elif any(_archive_projects().glob(f"*/{glob.escape(sid)}.jsonl")):
            console.print(f"[dim]archived copy of {sid[:8]} kept in "
                          f"{PROTECTED_ARCHIVE} (unprotect --purge deletes it)[/dim]")


def cmd_unprotect(target: str | None, *, project: str | None, purge: bool) -> int:
    """Drop a session or project flag; the archive is kept unless `purge`."""
    store = load_protected(strict=True)
    rows = {r["id"]: r for r in session_index(store=store)}
    if project is not None:
        path = _abs_project(project)
        if path not in store["projects"]:
            console.print(f"[red]not a protected project:[/red] {path}")
            return 1
        _record_unprotect(store, "project", path, store["projects"].pop(path))
        save_protected(store)
        console.print(f"[green]unprotected project[/green] {path}")
        affected = [sid for sid, r in rows.items() if _under(r["cwd"], path)
                    and not protection(sid, r["cwd"], store)[0]]
        _kept_or_purged(affected, rows, purge)
        return 0

    sid = _resolve_session(target, set(rows) | set(store["sessions"]))
    if sid not in store["sessions"]:
        rule = _project_rule(rows[sid]["cwd"], store) if sid in rows else None
        if rule is not None:
            console.print(f"[yellow]{sid[:8]} is covered by project rule[/yellow] "
                          f"{rule} — use [bold]unprotect --project {rule}[/bold]")
            return 1
        if not purge:
            console.print(f"[yellow]not protected:[/yellow] {sid}")
            return 1
    else:
        _record_unprotect(store, "session", sid, store["sessions"].pop(sid))
        save_protected(store)
        console.print(f"[green]unprotected[/green] {sid}")
        if sid in rows and protection(sid, rows[sid]["cwd"], store)[0]:
            console.print(f"[yellow]still covered by project rule[/yellow] "
                          f"{_project_rule(rows[sid]['cwd'], store)}")
            return 0
    _kept_or_purged([sid], rows, purge)
    return 0


def cmd_protect_toggle(target: str) -> int:
    """fzf ctrl-p: unprotect a session flagged by id; undo a recently
    unprotected one (`↩`: its session entry, else the covering project
    entry); else protect it."""
    store = load_protected(strict=True)
    rows = {r["id"]: r for r in session_index(store=store)}
    sid = _resolve_session(target, set(store["sessions"]) | set(rows))
    if sid in store["sessions"]:
        return cmd_unprotect(sid, project=None, purge=False)
    row = rows.get(sid)
    if row is not None and row["unprotected_at"]:
        return _restore_entry(store, undo_entry(sid, row["cwd"], store))
    return cmd_protect(sid, project=None, note=None)


def _read_tty(prompt: str) -> str | None:
    """One line typed on the terminal (fzf `execute` hands it over).

    Enter returns the line (possibly empty). Esc, ctrl-c, ctrl-d, EOF and a
    missing tty return None. The tty runs without canonical mode, echo and
    signals so Esc and ctrl-c arrive as bytes and never reach fzf as SIGINT;
    backspace and ctrl-u edit the line."""
    import select
    import termios

    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return None
    try:
        old = termios.tcgetattr(fd)
    except termios.error:
        os.close(fd)
        return None
    raw = termios.tcgetattr(fd)
    raw[3] &= ~(termios.ICANON | termios.ECHO | termios.ISIG)
    raw[6][termios.VMIN], raw[6][termios.VTIME] = 1, 0
    text = ""
    pending = b""  # partial UTF-8 sequence

    def erase(s: str) -> None:
        n = _cells(s)
        os.write(fd, b"\b" * n + b" " * n + b"\b" * n)

    try:
        termios.tcsetattr(fd, termios.TCSANOW, raw)
        os.write(fd, prompt.encode())
        while True:
            ch = os.read(fd, 1)
            if ch in (b"", b"\x03", b"\x04"):
                return None
            if ch == b"\x1b":
                if not select.select([fd], [], [], 0.05)[0]:
                    return None  # lone Esc
                # Arrow keys (ESC [ … final) and alt-chords (ESC x) are ignored.
                if os.read(fd, 1) in (b"[", b"O"):
                    while not 0x40 <= (os.read(fd, 1) or b"~")[0] <= 0x7e:
                        pass
                continue
            if ch in (b"\r", b"\n"):
                return text
            if ch in (b"\x7f", b"\x08"):
                if text:
                    erase(text[-1])
                    text = text[:-1]
                continue
            if ch == b"\x15":
                erase(text)
                text = ""
                continue
            if ch[0] < 0x20:
                continue
            pending += ch
            try:
                piece = pending.decode()
            except UnicodeDecodeError:
                if len(pending) >= 4:
                    pending = b""
                continue
            pending = b""
            text += piece
            os.write(fd, piece.encode())
    except OSError:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        os.write(fd, b"\r\n")
        os.close(fd)


def cmd_protect_ask_note(target: str) -> int:
    """Prompt for a note on the terminal, then protect (fzf ^n).

    Enter protects with the typed note (empty: no note); Esc / ctrl-c cancel."""
    line = _read_tty("enter = protect (empty = no note) · esc / ctrl-c = cancel\n"
                     f"note for {target[:8]}: ")
    if line is None:
        return 1
    return cmd_protect(target, project=None, note=line.strip() or None)


def cmd_protect_list() -> int:
    from rich.table import Table

    store = load_protected()
    rows = session_index(store=store)
    by_id = {r["id"]: r for r in rows}
    archived = {p.stem for p in _archive_projects().glob("*/*.jsonl")}
    listed = [r for r in rows if r["protected"]]
    missing = sorted(sid for sid in store["sessions"] if sid not in by_id)
    yes, no = "[green]yes[/green]", "[red]no[/red]"
    if not listed and not missing and not store["projects"]:
        console.print("no protected sessions or projects")
    else:
        _protected_tables(store, rows, listed, missing, archived, yes, no)

    if store["unprotected"]:
        utable = Table(title="recently unprotected (protect --undo \\[id|path])",
                       title_justify="left")
        for col in ("id/path", "title", "note", "removed", "archived"):
            utable.add_column(col, overflow="fold" if col == "title" else None)
        for entry in store["unprotected"]:
            kind, key = _entry_key(entry)
            ts = _iso_ts(entry["removed"])
            removed = f"{_age(ts)} ago" if ts is not None else "?"
            if kind == "session":
                row = by_id.get(key)
                title = (_fit(row["title"] or "(untitled)", 50).rstrip() if row
                         else "[dim](no transcript)[/dim]")
                utable.add_row(key[:8], title, entry.get("note") or "", removed,
                               yes if key in archived else no)
            else:
                under = [r["id"] for r in rows if _under(r["cwd"], key)]
                utable.add_row(key, f"[dim]project, {len(under)} session(s)[/dim]",
                               entry.get("note") or "", removed,
                               yes if archived & set(under) else no)
        console.print(utable)
    return 0


def _protected_tables(store: dict, rows: list[dict], listed: list[dict],
                      missing: list[str], archived: set[str], yes: str,
                      no: str) -> None:
    from rich.table import Table

    table = Table(title="protected sessions", title_justify="left")
    for col in ("id", "title", "note", "archived", "live"):
        table.add_column(col, overflow="fold" if col == "title" else None)
    for r in listed:
        table.add_row(r["id"][:8], _fit(r["title"] or "(untitled)", 50).rstrip(),
                      r["note"] or "", yes if r["id"] in archived else no,
                      yes if r["live"] else no)
    for sid in missing:
        table.add_row(sid[:8], "[dim](no transcript)[/dim]",
                      store["sessions"][sid].get("note") or "", no, no)
    console.print(table)

    if store["projects"]:
        ptable = Table(title="protected projects", title_justify="left")
        for col in ("path", "note", "sessions", "added"):
            ptable.add_column(col)
        for path, entry in sorted(store["projects"].items()):
            count = sum(1 for r in rows if _under(r["cwd"], path))
            ptable.add_row(path, entry.get("note") or "", str(count),
                           entry.get("added") or "")
        console.print(ptable)


def _protect_main(args: list[str], passthrough: list[str], *, unprotect: bool) -> int:
    name = "unprotect" if unprotect else "protect"
    usage = ("[red]usage:[/red] claude-as unprotect <id-prefix>|--project <path> "
             "\\[--purge]" if unprotect else
             "[red]usage:[/red] claude-as protect <id-prefix>|--project <path> "
             "\\[--note TEXT] | --list | --undo \\[<id-prefix>|<path>]")
    valued = ("--project",) if unprotect else ("--project", "--note", "--toggle",
                                               "--ask-note")
    flags = ("--purge",) if unprotect else ("--list", "--undo")
    opts: dict[str, str | bool] = {}
    targets: list[str] = []
    it = iter(args)
    for arg in it:
        if arg in valued:
            val = next(it, None)
            if val is None:
                console.print(f"[red]{arg} needs a value[/red]")
                console.print(usage)
                return 2
            opts[arg] = val
        elif arg in flags:
            opts[arg] = True
        elif arg.startswith("-"):
            console.print(f"[red]unknown {name} option:[/red] {arg}")
            console.print(usage)
            return 2
        else:
            targets.append(arg)
    if "--undo" in opts:
        if passthrough or len(targets) > 1 or len(opts) != 1:
            console.print(usage)
            return 2
        return cmd_protect_undo(targets[0] if targets else None)
    picks = [k for k in ("--project", "--list", "--toggle", "--ask-note") if k in opts]
    if passthrough or len(targets) + len(picks) != 1 or (
            "--note" in opts and picks not in ([], ["--project"])):
        console.print(usage)
        return 2
    target = targets[0] if targets else None
    if unprotect:
        return cmd_unprotect(target, project=opts.get("--project"),
                             purge=bool(opts.get("--purge")))
    if "--list" in opts:
        return cmd_protect_list()
    if "--toggle" in opts:
        return cmd_protect_toggle(opts["--toggle"])
    if "--ask-note" in opts:
        return cmd_protect_ask_note(opts["--ask-note"])
    return cmd_protect(target, project=opts.get("--project"), note=opts.get("--note"))


