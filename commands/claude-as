def cmd_resume(target: str, *, selector: str | None, passthrough: list[str],
               force_resume: bool) -> int:
    """Resume a session by id or unique prefix (no picker)."""
    rows = session_index()
    sid = _resolve_session(target, (r["id"] for r in rows))
    _sync_quietly(rows)
    row = next(r for r in rows if r["id"] == sid)
    return resume_row(row, selector=selector, passthrough=passthrough,
                      force_resume=force_resume)


def _resume_main(args: list[str], passthrough: list[str]) -> int:
    usage = ("[red]usage:[/red] claude-as resume <id-prefix> \\[--as <sel>] "
             "\\[--force-resume] \\[-- <claude args>]")
    selector = None
    force_resume = False
    targets: list[str] = []
    it = iter(args)
    for arg in it:
        if arg == "--as":
            selector = next(it, None)
            if selector is None:
                console.print("[red]--as needs a value[/red]")
                console.print(usage)
                return 2
        elif arg == "--force-resume":
            force_resume = True
        elif arg.startswith("-"):
            console.print(f"[red]unknown resume option:[/red] {arg}")
            console.print(usage)
            return 2
        else:
            targets.append(arg)
    if len(targets) != 1:
        console.print(usage)
        return 2
    return cmd_resume(targets[0], selector=selector, passthrough=passthrough,
                      force_resume=force_resume)


# --- backlog -----------------------------------------------------------------

# Sessions put away to resume later (the herdr-app Backlog tab drives these).
# BACKLOG_FILE = {"entries": {id: entry}, "bin": {id: entry}}; an entry is
#   {"id", "title", "note", "cwd", "branch", "session_name", "first_prompt",
#    "last_prompt", "launcher", "protected_before", "meta", "archived_at"}
# and a binned one adds "binned_at" and "reason" ("deleted" | "resumed").
# `launcher` says how to start it again: {"kind": "plain"} (no
# CLAUDE_CONFIG_DIR), {"kind": "as", "account": <email>|"default"} (an
# account dir of this data dir) or {"kind": "config_dir", "config_dir": ...}.
# Adding protects the session (backup in PROTECTED_ARCHIVE); purging a binned
# entry drops that flag and backup again unless the session was protected
# before (`protected_before`). Binned entries are purged BACKLOG_BIN_DAYS after
# binned_at, by any `backlog list` / `add` / `resume`. `meta` is opaque
# caller data (herdr: machine, space, tab).
# All backlog commands print one JSON object on stdout: {"ok": true, ...} or
# {"ok": false, "error": ..., ...}.
BACKLOG_FILE = PROTECT_HOME / "backlog.json"
BACKLOG_BIN_DAYS = 7
BACKLOG_REASONS = ("deleted", "resumed")
# Claude's Bash tool (foreground and run_in_background) runs every command as
# `<shell> -c source <config>/shell-snapshots/snapshot-<shell>-….sh … && eval …`,
# a child of the claude process.
BASH_TOOL_MARK = "shell-snapshots/snapshot-"
TERMINATE_SECS = 5.0


def _emit(obj: dict) -> None:
    print(json.dumps(obj), flush=True)


def _fail(msg: str, code: int = 1, **extra) -> int:
    _emit({"ok": False, "error": msg, **extra})
    return code


@contextlib.contextmanager
def _backlog_locked():
    """Exclusive flock on BACKLOG_FILE.lock for a read-modify-write."""
    lock = BACKLOG_FILE.with_name(f"{BACKLOG_FILE.name}.lock")
    lock.parent.mkdir(parents=True, exist_ok=True)
    with open(lock, "a") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def load_backlog() -> dict:
    """BACKLOG_FILE as {"entries": {...}, "bin": {...}}; missing = empty,
    unreadable = exit 1 (it is written back, so never read it as empty)."""
    try:
        with open(BACKLOG_FILE) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError) as exc:
        _fail(f"cannot read {BACKLOG_FILE}: {exc}")
        raise SystemExit(1)
    if not isinstance(data, dict):
        data = {}
    out = {}
    for key in ("entries", "bin"):
        section = data.get(key)
        out[key] = ({sid: e for sid, e in section.items() if isinstance(e, dict)}
                    if isinstance(section, dict) else {})
    return out


def save_backlog(data: dict) -> None:
    _write_json_atomic(BACKLOG_FILE, {"entries": data["entries"], "bin": data["bin"]})


def _proc_table() -> dict[int, tuple[int, str]]:
    """pid -> (ppid, command) for every process, from one `ps` call."""
    out = {}
    for line in _ps(["-axo", "pid=,ppid=,command="]).splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        out[int(parts[0])] = (int(parts[1]), parts[2].strip() if len(parts) > 2 else "")
    return out


def _descendants(pid: int, table: dict[int, tuple[int, str]]) -> list[int]:
    """Children of pid, then theirs (breadth first)."""
    kids: dict[int, list[int]] = {}
    for child, (parent, _) in table.items():
        kids.setdefault(parent, []).append(child)
    out, queue = [], sorted(kids.get(pid, []))
    while queue:
        p = queue.pop(0)
        out.append(p)
        queue.extend(sorted(kids.get(p, [])))
    return out


def _proc_env(pid: int) -> dict[str, str] | None:
    """Environment of one of the user's processes; None when unreadable."""
    if IS_MAC:
        try:
            raw = _mac_proc_environ(pid)
        except Exception:
            raw = None
    else:
        try:
            raw = (PROC_ROOT / str(pid) / "environ").read_bytes().split(b"\0")
        except OSError:
            raw = None
    if raw is None:
        return None
    env = {}
    for item in raw:
        key, sep, val = item.decode(errors="replace").partition("=")
        if sep:
            env[key] = val
    return env


def _launcher_of(pid: int) -> dict:
    """How the claude process `pid` was started (see BACKLOG_FILE)."""
    val = (_proc_env(pid) or {}).get("CLAUDE_CONFIG_DIR")
    if not val:
        return {"kind": "plain"}
    norm = os.path.normpath(val)
    home = find_home()
    if home is not None:
        root = home / "accounts"
        parent = os.path.dirname(norm)
        if (os.path.normpath(str(root)) == parent
                or os.path.realpath(parent) == os.path.realpath(root)):
            return {"kind": "as", "account": os.path.basename(norm)}
    return {"kind": "config_dir", "config_dir": val}


def _shell_label(cmd: str) -> str:
    """The user-visible part of a Bash-tool command line."""
    if " eval " in cmd:
        cmd = cmd.split(" eval ", 1)[1]
    return _oneline(cmd.strip().strip("'\""), 120)


def _busy_reasons(claude_pid: int, status: str,
                  table: dict[int, tuple[int, str]]) -> list[str]:
    """Why the session must not be stopped now: claude is mid-turn (anything
    but idle), or one of its Bash-tool shells is still running. Other children
    (MCP servers, caffeinate, the status line) do not count."""
    reasons = [f"claude is {status}"] if status and status != "idle" else []
    for p in _descendants(claude_pid, table):
        cmd = table[p][1]
        if BASH_TOOL_MARK in cmd:
            reasons.append(f"shell: {_shell_label(cmd)}")
    return reasons


def _terminate(pid: int, timeout: float = TERMINATE_SECS) -> bool:
    """SIGTERM (so claude runs its SessionEnd hooks), SIGKILL after `timeout`.
    True once the process is gone."""
    def gone() -> bool:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        except OSError:
            return False
        return False

    for sig, wait in ((signal.SIGTERM, timeout), (signal.SIGKILL, 2.0)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return True
        except OSError:
            return False
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if gone():
                return True
            time.sleep(0.1)
    return gone()


def _backlog_resolve(prefix: str, ids) -> tuple[str | None, str | None]:
    """(id, None) for an exact id or unique prefix, else (None, error)."""
    ids = set(ids)
    if prefix in ids:
        return prefix, None
    cands = sorted(i for i in ids if prefix and i.startswith(prefix))
    if len(cands) == 1:
        return cands[0], None
    if cands:
        return None, f"ambiguous id {prefix!r}: {', '.join(c[:8] for c in cands)}"
    return None, f"not found: {prefix!r}"


def _purge_binned(data: dict, sid: str) -> None:
    """Drop a binned entry, and the protection the backlog added (flag and
    backup) unless the session was protected before or is still listed."""
    entry = data["bin"].pop(sid)
    if entry.get("protected_before") or sid in data["entries"]:
        return
    store = load_protected(strict=True)
    if store["sessions"].pop(sid, None) is not None:
        save_protected(store)
    if not protection(sid, str(entry.get("cwd") or ""), store)[0]:
        purge_archive(sid)


def _purge_expired(data: dict, now: float | None = None) -> list[str]:
    """Purge binned entries older than BACKLOG_BIN_DAYS; returns their ids."""
    cutoff = (now if now is not None else time.time()) - BACKLOG_BIN_DAYS * 86400
    old = [sid for sid, e in data["bin"].items()
           if (ts := _iso_ts(e.get("binned_at"))) is not None and ts < cutoff]
    for sid in old:
        _purge_binned(data, sid)
    return old


def cmd_backlog_add(pid: int, *, title: str | None, note: str | None,
                    meta: dict, kill: bool = True) -> int:
    """Put away the claude session running in process `pid` (or below it):
    refuse while it is busy, record it, protect and archive it, stop it."""
    table = _proc_table()
    by_pid = {v["pid"]: (sid, v) for sid, v in active_sessions().items()}
    cpid = next((p for p in [pid, *_descendants(pid, table)] if p in by_pid), None)
    if cpid is None:
        return _fail(f"no claude session in process {pid} or below")
    sid, act = by_pid[cpid]
    busy = _busy_reasons(cpid, act["status"], table)
    if busy:
        return _fail(f"session {sid[:8]} is still running something", busy=busy, id=sid)
    launcher = _launcher_of(cpid)

    store = load_protected(strict=True)
    row = next((r for r in session_index(store=store) if r["id"] == sid), None)
    if row is None:
        return _fail(f"no transcript for session {sid} yet", id=sid)
    with _backlog_locked():
        data = load_backlog()
        _purge_expired(data)
        prev = data["entries"].get(sid) or data["bin"].get(sid)
        protected_before = (bool(prev.get("protected_before")) if prev
                            else protection(sid, row["cwd"], store)[0])
        prev = prev or {}
        note = (note if note is not None else prev.get("note")) or None
        if not protected_before:
            _set_flag(store, "session", sid, note)
            save_protected(store)
        entry = {
            "id": sid,
            "title": title or prev.get("title") or row["title"] or act["name"] or sid[:8],
            "note": note,
            "cwd": row["cwd"] or act["cwd"],
            "branch": row["branch"],
            "session_name": act["name"],
            "first_prompt": row["first_prompt"],
            "last_prompt": row["last_prompt"],
            "launcher": launcher,
            "protected_before": protected_before,
            "meta": meta,
            "archived_at": _now_iso(),
        }
        data["entries"][sid] = entry
        data["bin"].pop(sid, None)
        save_backlog(data)

    transcript = Path(row["path"])
    fh_dirs = _file_history_dirs()
    if row["live"]:
        archive_session(transcript, fh_dirs)
    killed = _terminate(cpid) if kill else False
    if killed and row["live"] and transcript.exists():
        archive_session(transcript, fh_dirs)  # whatever it wrote on the way out
    _emit({"ok": True, "entry": entry, "killed": killed, "pid": cpid})
    return 0


def _backlog_rows() -> dict[str, dict]:
    try:
        return {r["id"]: r for r in session_index()}
    except Exception as exc:  # the list still shows without the index
        print(f"warning: session index failed: {exc}", file=sys.stderr)
        return {}


def _joined(entry: dict, rows: dict[str, dict]) -> dict:
    """An entry with the session index's live view of it."""
    r = rows.get(entry["id"]) or {}
    cwd = str(entry.get("cwd") or "")
    return {
        **entry,
        "transcript": bool(r),
        "live": bool(r.get("live")),
        "active": bool(r.get("active")),
        "active_status": r.get("active_status"),
        "cwd_exists": bool(cwd) and os.path.isdir(cwd),
        "ai_title": r.get("ai_title", ""),
        "first_prompt": entry.get("first_prompt") or r.get("first_prompt", ""),
        "last_prompt": r.get("last_prompt") or entry.get("last_prompt", ""),
        "mtime": r.get("mtime"),
    }


def cmd_backlog_list(as_json: bool) -> int:
    with _backlog_locked():
        data = load_backlog()
        if _purge_expired(data):
            save_backlog(data)
    rows = _backlog_rows()
    by = lambda key: (lambda e: _iso_ts(e.get(key)) or 0)  # noqa: E731
    entries = [_joined(e, rows) for e in sorted(data["entries"].values(),
                                                key=by("archived_at"), reverse=True)]
    binned = [_joined(e, rows) for e in sorted(data["bin"].values(),
                                               key=by("binned_at"), reverse=True)]
    if as_json:
        _emit({"ok": True, "entries": entries, "bin": binned})
        return 0
    for label, items, key in (("backlog", entries, "archived_at"), ("bin", binned, "binned_at")):
        console.print(f"[bold]{label}[/bold] ({len(items)})")
        for e in items:
            ts = _iso_ts(e.get(key))
            age = _age(ts) if ts is not None else "?"
            console.print(f"  {e['id'][:8]}  {age:>4}  {_fit(e['title'] or '', 50).rstrip()}"
                          f"  [dim]{_tilde(e.get('cwd') or '')}[/dim]"
                          + (f"  [italic]{e['note']}[/italic]" if e.get("note") else ""),
                          highlight=False)
    return 0


def cmd_backlog_edit(target: str, *, title: str | None, note: str | None) -> int:
    with _backlog_locked():
        data = load_backlog()
        sid, err = _backlog_resolve(target, data["entries"])
        if sid is None:
            return _fail(err)
        entry = data["entries"][sid]
        if title is not None:
            entry["title"] = title or entry["title"]
        if note is not None:
            entry["note"] = note or None
        save_backlog(data)
    _emit({"ok": True, "entry": entry})
    return 0


def cmd_backlog_bin(target: str, reason: str) -> int:
    with _backlog_locked():
        data = load_backlog()
        sid, err = _backlog_resolve(target, data["entries"])
        if sid is None:
            return _fail(err)
        entry = data["entries"].pop(sid)
        entry.update(binned_at=_now_iso(), reason=reason)
        data["bin"][sid] = entry
        save_backlog(data)
    _emit({"ok": True, "entry": entry})
    return 0


def cmd_backlog_restore(target: str) -> int:
    with _backlog_locked():
        data = load_backlog()
        sid, err = _backlog_resolve(target, data["bin"])
        if sid is None:
            return _fail(err)
        entry = data["bin"].pop(sid)
        entry.pop("binned_at", None)
        entry.pop("reason", None)
        data["entries"][sid] = entry
        save_backlog(data)
    _emit({"ok": True, "entry": entry})
    return 0


def cmd_backlog_purge(target: str) -> int:
    with _backlog_locked():
        data = load_backlog()
        sid, err = _backlog_resolve(target, data["bin"])
        if sid is None:
            return _fail(err)
        _purge_binned(data, sid)
        save_backlog(data)
    _emit({"ok": True, "id": sid})
    return 0


def _exec_claude(args: list[str], config_dir: str | None) -> None:
    """Exec claude (through claude-custom when on PATH) with CLAUDE_CONFIG_DIR
    = config_dir, or unset for a plain session."""
    exe = shutil.which("claude-custom") or shutil.which("claude")
    if not exe:
        raise SystemExit("neither claude-custom nor claude found on PATH")
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if config_dir:
        env["CLAUDE_CONFIG_DIR"] = config_dir
    _sync_quietly()
    os.execve(exe, [exe, *args], env)


def cmd_backlog_resume(target: str, *, passthrough: list[str], force_resume: bool) -> int:
    """Resume a backlog entry the way it was launched, in its dir; the entry
    moves to the bin (reason "resumed") just before claude starts."""
    with _backlog_locked():
        data = load_backlog()
        if _purge_expired(data):
            save_backlog(data)
    sid, err = _backlog_resolve(target, data["entries"])
    if sid is None:
        return _fail(err)
    entry = data["entries"][sid]
    row = next((r for r in session_index() if r["id"] == sid), None)
    if row is None:
        return _fail(f"no transcript or backup left for {sid}")
    if row["active"] and not force_resume:
        return _fail(f"already running: pid {row['active_pid']}, status "
                     f"{row['active_status'] or '?'} (--force-resume opens it anyway)")
    launcher = entry.get("launcher") or {"kind": "plain"}
    account = launcher.get("account") if launcher.get("kind") == "as" else None
    if not row["live"]:
        target_acct = account
        if account == DEFAULT_NAME:
            target_acct = None
            with contextlib.suppress(DefaultError):
                target_acct = current_default()
        try:
            restore_session(row, target_acct)
        except OSError as exc:
            return _fail(f"cannot restore {sid} from backup: {exc}")
    cwd = str(entry.get("cwd") or row["cwd"] or "")
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    else:
        # A removed worktree or subdir: its nearest surviving parent.
        near = os.path.dirname(cwd) if cwd else ""
        while near and near != os.path.dirname(near) and not os.path.isdir(near):
            near = os.path.dirname(near)
        if near and near != os.path.dirname(near):
            os.chdir(near)
        print(f"warning: session dir {cwd or '(unknown)'} no longer exists — "
              f"resuming from {os.getcwd()}", file=sys.stderr)

    def move(to_bin: bool) -> None:
        with _backlog_locked():
            data = load_backlog()
            if to_bin and sid in data["entries"]:
                e = data["entries"].pop(sid)
                e.update(binned_at=_now_iso(), reason="resumed")
                data["bin"][sid] = e
            elif not to_bin and sid in data["bin"]:
                e = data["bin"].pop(sid)
                e.pop("binned_at", None)
                e.pop("reason", None)
                data["entries"][sid] = e
            save_backlog(data)

    move(True)
    args = ["--resume", sid, *passthrough]
    try:
        if account == DEFAULT_NAME:
            rc = launch_default(args)
            if rc:
                move(False)
            return rc
        if account:
            launch(account, args)  # execs
        else:
            _exec_claude(args, launcher.get("config_dir"))  # execs
    except BaseException:
        move(False)
        raise
    return 0


def _backlog_main(args: list[str], passthrough: list[str]) -> int:
    usage = ("[red]usage:[/red] claude-as backlog "
             "add --pid <pid> \\[--title T] \\[--note N] \\[--meta JSON] \\[--no-kill]"
             " | list \\[--json] | edit <id> \\[--title T] \\[--note N]"
             " | bin <id> \\[--reason deleted|resumed] | restore <id> | purge <id>"
             " | resume <id> \\[--force-resume] \\[-- <claude args>]")
    if not args:
        console.print(usage)
        return 2
    sub, rest = args[0], args[1:]
    valued = {"--pid", "--title", "--note", "--meta", "--reason"}
    flags = {"--json", "--no-kill", "--force-resume"}
    opts: dict[str, str | bool] = {}
    targets: list[str] = []
    it = iter(rest)
    for arg in it:
        if arg in valued:
            val = next(it, None)
            if val is None:
                console.print(f"[red]{arg} needs a value[/red]")
                return 2
            opts[arg] = val
        elif arg in flags:
            opts[arg] = True
        elif arg.startswith("-"):
            console.print(f"[red]unknown backlog option:[/red] {arg}")
            console.print(usage)
            return 2
        else:
            targets.append(arg)
    allowed = {"add": {"--pid", "--title", "--note", "--meta", "--no-kill"},
               "list": {"--json"}, "edit": {"--title", "--note"},
               "bin": {"--reason"}, "restore": set(), "purge": set(),
               "resume": {"--force-resume"}}
    if sub not in allowed or set(opts) - allowed[sub] or (
            passthrough and sub != "resume"):
        console.print(usage)
        return 2
    if sub in ("add", "list"):
        if targets:
            console.print(usage)
            return 2
    elif len(targets) != 1:
        console.print(usage)
        return 2

    if sub == "add":
        pid, meta = opts.get("--pid"), opts.get("--meta", "{}")
        if not isinstance(pid, str) or not pid.isdigit():
            console.print("[red]--pid needs a process id[/red]")
            return 2
        try:
            meta = json.loads(meta)
        except ValueError:
            meta = None
        if not isinstance(meta, dict):
            console.print("[red]--meta must be a JSON object[/red]")
            return 2
        return cmd_backlog_add(int(pid), title=opts.get("--title"), note=opts.get("--note"),
                               meta=meta, kill="--no-kill" not in opts)
    if sub == "list":
        return cmd_backlog_list("--json" in opts)
    target = targets[0]
    if sub == "edit":
        if "--title" not in opts and "--note" not in opts:
            console.print(usage)
            return 2
        return cmd_backlog_edit(target, title=opts.get("--title"), note=opts.get("--note"))
    if sub == "bin":
        reason = opts.get("--reason", "deleted")
        if reason not in BACKLOG_REASONS:
            console.print(f"[red]--reason must be one of:[/red] {', '.join(BACKLOG_REASONS)}")
            return 2
        return cmd_backlog_bin(target, reason)
    if sub == "restore":
        return cmd_backlog_restore(target)
    if sub == "purge":
        return cmd_backlog_purge(target)
    return cmd_backlog_resume(target, passthrough=passthrough,
                              force_resume="--force-resume" in opts)


# --- remind ------------------------------------------------------------------

# REMINDERS_FILE = {"reminders": [record, ...]}; a record is
#   {"id", "note", "due", "created", "session_id", "cwd", "repo_label",
#    "status": "pending"|"fired"|"cancelled", "fired_at", "cancelled_at",
#    "attempts", "last_error", "acked_at", "acked_via", "tg_message_id",
#    "snoozed_from"}
# with ISO 8601 times (local offset); the ack fields and snoozed_from are None
# (or absent in older records) until set. snoozed_from is {"due", "fired_at"}
# of a missed reminder that snooze_reminder made pending; unsnooze_reminder
# restores them, and firing, acking or cancelling clears it.
# Read-modify-write runs under an flock on REMINDERS_FILE + ".lock". The
# systemd user timer runs `remind dispatch` every minute. A fired reminder is missed until acked (ack_reminder);
# unack_reminder makes an acked one missed again. Missed ones are never
# pruned, acked ones are pruned REMIND_KEEP_DAYS after acked_at, cancelled
# ones REMIND_KEEP_DAYS after cancelled_at.
#
# Each sent reminder message carries inline buttons (TG_ACTIONS, callback_data
# `rem:<id>:<action>`) and its message_id is kept in tg_message_id.
# `remind listen` long-polls getUpdates for button presses (tg_poll); every
# dispatch run sends due reminders, then the weekly digest of missed
# reminders (tg_digest) once DIGEST_WEEKDAY DIGEST_HOUR:00 local has passed
# since the last one.
# TG_STATE_FILE holds {"offset": next getUpdates offset, "chat_id": the
# configured chat, learned once, "digest_last": when the digest window was
# last checked, "digest_message_id": the latest digest, "digest_ids": the
# reminder ids it lists, "digest_acked_ids": the ones its Ack all acked, for
# its undo button}; it is read-modify-written under the same lock as
# REMINDERS_FILE.
REMINDERS_FILE = PROTECT_HOME / "reminders.json"
TG_STATE_FILE = PROTECT_HOME / "tg-state.json"
TG_API_TIMEOUT_SECS = 30
TG_POLL_TIMEOUT_SECS = 50  # under tg-notify --api's curl --max-time 70
TG_POLL_GRACE_SECS = 20
LISTEN_BACKOFF_SECS = (5, 60)  # first and max sleep after a failed poll
TG_ACTIONS = (("ack", "✅ Ack", None), ("1h", "⏰ +1h", 3600), ("1d", "⏰ +1d", 86400))
DIGEST_WEEKDAY = 0  # Monday
DIGEST_HOUR = 9
DIGEST_MARKUP = {"inline_keyboard": [[{"text": "✅ Ack all", "callback_data": "dig:ackall"}]]}
REMIND_KEEP_DAYS = 30
ACK_FIELDS = ("acked_at", "acked_via", "tg_message_id")
ACK_VIA = ("manual", "telegram", "digest")
REMIND_LATE_SECS = 5 * 60
REMIND_UNIT = "claude-as-remind"
LISTEN_UNIT = "claude-as-remind-listen"
SYSTEMD_USER_DIR = Path.home() / ".config" / "systemd" / "user"
# macOS: launchd agents instead of systemd units.
LAUNCH_AGENTS_DIR = Path.home() / "Library" / "LaunchAgents"
LAUNCHD_LOG_DIR = Path.home() / "Library" / "Logs" / "claude-as"
REMIND_LABEL = "com.claude-as.remind"
LISTEN_LABEL = "com.claude-as.remind-listen"
TG_NOTIFY_FALLBACK = Path.home() / ".local" / "bin" / "tg-notify"
NOTIFY_TIMEOUT_SECS = 240  # tg-notify retries by itself, up to about 3 minutes
TG_MAYBE_SENT = 75  # tg-notify exit: may have been delivered, don't resend
TG_MISSING = "tg-notify not found"
LAST_ERROR_MAX = 300
_DUR_UNITS = {"m": 60, "h": 3600, "d": 86400, "w": 7 * 86400}


def parse_duration(text: str) -> int:
    """Seconds in `30m`, `3h`, `2d`, `2w` or a combination such as `1d12h`."""
    if not re.fullmatch(r"(?:\d+[mhdw])+", text):
        raise ValueError(f"bad duration {text!r} (e.g. 30m, 3h, 2d, 2w, 1d12h)")
    secs = sum(int(n) * _DUR_UNITS[u] for n, u in re.findall(r"(\d+)([mhdw])", text))
    if secs <= 0:
        raise ValueError(f"duration {text!r} is zero")
    return secs


def parse_when(text: str, now: float | None = None) -> float:
    """Epoch seconds of a local `YYYY-MM-DD HH:MM`, `YYYY-MM-DDTHH:MM`, or
    `HH:MM` (today, or tomorrow once that time has passed). Past times are
    rejected."""
    now = now if now is not None else time.time()
    text = text.strip()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M"):
        try:
            ts = datetime.strptime(text, fmt).timestamp()
        except ValueError:
            continue
        if ts <= now:
            raise ValueError(f"{text} is in the past")
        return ts
    try:
        hm = datetime.strptime(text, "%H:%M")
    except ValueError:
        raise ValueError(f"bad time {text!r} (want YYYY-MM-DD HH:MM, "
                         f"YYYY-MM-DDTHH:MM or HH:MM)") from None
    day = datetime.fromtimestamp(now)
    dt = day.replace(hour=hm.hour, minute=hm.minute, second=0, microsecond=0)
    if dt.timestamp() <= now:
        dt += timedelta(days=1)
    return dt.timestamp()


def _span(secs: float) -> str:
    """Up to two units: `45s`, `30m`, `1h30m`, `1d2h`."""
    secs = int(abs(secs))
    if secs < 60:
        return f"{secs}s"
    d, rem = divmod(secs, 86400)
    h, rem = divmod(rem, 3600)
    parts = [(d, "d"), (h, "h"), (rem // 60, "m")]
    first = next(i for i, (n, _) in enumerate(parts) if n)
    return "".join(f"{n}{u}" for n, u in parts[first:first + 2] if n)


def _relative(ts: float, now: float | None = None) -> str:
    now = now if now is not None else time.time()
    return f"in {_span(ts - now)}" if ts > now else f"{_span(now - ts)} ago"


def _iso_at(ts: float) -> str:
    return datetime.fromtimestamp(ts).astimezone().isoformat(timespec="seconds")


def _local(ts: float) -> str:
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def _repo_label(cwd: str) -> str:
    """`<repo>@<branch>` when cwd is in a git work tree, else cwd."""
    def git(*args: str) -> str | None:
        try:
            proc = subprocess.run(["git", "-C", cwd, *args], capture_output=True,
                                  text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return proc.stdout.strip() if proc.returncode == 0 else None

    top = git("rev-parse", "--show-toplevel")
    if not top:
        return cwd
    return f"{os.path.basename(top)}@{git('branch', '--show-current') or 'detached'}"


@contextlib.contextmanager
def _reminders_locked():
    """Exclusive flock on REMINDERS_FILE.lock for a read-modify-write."""
    lock = REMINDERS_FILE.with_name(f"{REMINDERS_FILE.name}.lock")
    lock.parent.mkdir(parents=True, exist_ok=True)
    with open(lock, "a") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def load_reminders() -> list[dict]:
    """Records in REMINDERS_FILE; missing = empty, unreadable = exit 1."""
    try:
        with open(REMINDERS_FILE) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as exc:
        console.print(f"[red]cannot read {REMINDERS_FILE}:[/red] {exc}")
        raise SystemExit(1)
    rems = data.get("reminders") if isinstance(data, dict) else None
    if not isinstance(rems, list):
        return []
    return [r for r in rems if isinstance(r, dict) and isinstance(r.get("id"), str)]


def save_reminders(rems: list[dict]) -> None:
    _write_json_atomic(REMINDERS_FILE, {"reminders": rems})


def _find_reminder(rems: list[dict], ident: str) -> dict | None:
    """Record with id `ident`, else the unique one starting with it."""
    exact = [r for r in rems if r["id"] == ident]
    hits = exact or [r for r in rems if ident and r["id"].startswith(ident)]
    if len(hits) == 1:
        return hits[0]
    if hits:
        console.print(f"[red]ambiguous reminder id[/red] {ident!r}: "
                      f"{', '.join(r['id'] for r in hits)}")
    else:
        console.print(f"[red]unknown reminder:[/red] {ident!r}")
    return None


def _reminder_state(rem: dict) -> str:
    """"pending", "missed" (fired, not acked), "acked" or "cancelled"."""
    status = rem.get("status")
    if status == "fired":
        return "acked" if rem.get("acked_at") else "missed"
    return "cancelled" if status == "cancelled" else "pending"


def ack_reminder(rem: dict, via: str, now: float) -> bool:
    """Mark a missed reminder acked at `now` via `via` (one of ACK_VIA); False
    (record unchanged) unless it was missed. The caller holds the lock and
    saves."""
    if via not in ACK_VIA:
        raise ValueError(f"bad ack source {via!r}")
    if _reminder_state(rem) != "missed":
        return False
    rem.update(acked_at=_iso_at(now), acked_via=via, snoozed_from=None)
    return True


def unack_reminder(rem: dict) -> bool:
    """Clear an acked reminder's ack so it is missed again; False (record
    unchanged) unless it was acked. The caller holds the lock and saves."""
    if _reminder_state(rem) != "acked":
        return False
    rem.update(acked_at=None, acked_via=None)
    return True


def reminder_message(rem: dict, now: float | None = None) -> str:
    """tg-notify --html text. The first line is the title, which tg-notify
    escapes itself; the body lines are escaped here."""
    def esc(text: str) -> str:
        return html.escape(text, quote=False)

    now = now if now is not None else time.time()
    lines = [f"⏰ {' '.join(str(rem.get('note') or '').split())}"]
    due = _iso_ts(rem.get("due"))
    if due is not None and now - due > REMIND_LATE_SECS:
        stamp = datetime.fromtimestamp(due).strftime("%H:%M %d %b")
        lines.append(f"<i>late: due {esc(stamp)}</i>")
    created = _iso_ts(rem.get("created"))
    set_at = f"set {_relative(created, now)}" if created is not None else "set ?"
    lines.append(f"{set_at} · {esc(str(rem.get('repo_label') or rem.get('cwd') or '?'))}")
    if rem.get("session_id"):
        lines.append(f"<code>claude-as resume {esc(rem['session_id'])}</code>")
    else:
        lines.append(f"<code>cd {esc(shlex.quote(str(rem.get('cwd') or '~')))}</code>")
    return "\n".join(lines)


def _tg_notify() -> str:
    return shutil.which("tg-notify") or str(TG_NOTIFY_FALLBACK)


# What this process learned about tg-notify: _TG_MODE is None (untested),
# "missing" (not found) or "legacy" (rejects --reply-markup/--print-id);
# _TG_API is None (unprobed) or whether `tg-notify --api` works.
_TG_MODE: str | None = None
_TG_API: bool | None = None


class SendResult(NamedTuple):
    """send_notification outcome: message_id is None when tg-notify printed
    none; error is None on success; missing is True when tg-notify was not
    found (error TG_MISSING)."""
    message_id: int | None
    error: str | None
    missing: bool = False


def _proc_error(proc: subprocess.CompletedProcess) -> str:
    tail = (proc.stderr or proc.stdout or "").strip().splitlines()
    return (f"exit {proc.returncode}" + (f": {tail[-1]}" if tail else ""))[:LAST_ERROR_MAX]


def _unknown_flag(proc: subprocess.CompletedProcess) -> bool:
    """True for the usage error an older tg-notify gives for a flag it lacks."""
    return proc.returncode == 2 and "unknown flag" in (proc.stderr or "")


def send_notification(message: str, *, level: str = "info",
                      markup: dict | None = None) -> SendResult:
    """Send via tg-notify --print-id (with `markup` as --reply-markup). An
    older tg-notify that rejects those flags gets one plain resend (no
    buttons, message_id None) and every later send is plain. A missing
    tg-notify gives SendResult(None, TG_MISSING, missing=True)."""
    global _TG_MODE
    if _TG_MODE == "missing":
        return SendResult(None, TG_MISSING, True)
    plain = [_tg_notify(), "--html", "--no-context", "--level", level]
    cmd = plain
    if _TG_MODE != "legacy":
        if markup is not None:
            cmd = [*plain, "--reply-markup", json.dumps(markup, ensure_ascii=False)]
        cmd = [*cmd, "--print-id"]
    while True:
        try:
            proc = subprocess.run([*cmd, message], capture_output=True,
                                  text=True, timeout=NOTIFY_TIMEOUT_SECS)
        except FileNotFoundError:
            _TG_MODE = "missing"
            return SendResult(None, TG_MISSING, True)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return SendResult(None, (str(exc) or type(exc).__name__)[:LAST_ERROR_MAX])
        if cmd is not plain and _unknown_flag(proc):
            _TG_MODE = "legacy"
            cmd = plain
            continue
        break
    if proc.returncode == TG_MAYBE_SENT:
        return SendResult(None, None)
    if proc.returncode != 0:
        return SendResult(None, _proc_error(proc))
    out = proc.stdout.strip()
    return SendResult(int(out) if out.isdigit() and cmd is not plain else None, None)


def tg_api_supported() -> bool:
    """Whether tg-notify has --api, probed once per process: a new tg-notify
    rejects the method `probe!` as invalid (exit 2) before reading secrets or
    calling Telegram; an older one reports an unknown flag."""
    global _TG_API, _TG_MODE
    if _TG_API is None:
        if _TG_MODE == "missing":
            _TG_API = False
            return False
        try:
            proc = subprocess.run([_tg_notify(), "--api", "probe!"], input="",
                                  capture_output=True, text=True,
                                  timeout=TG_API_TIMEOUT_SECS)
        except FileNotFoundError:
            _TG_MODE = "missing"
            _TG_API = False
        except (OSError, subprocess.TimeoutExpired):
            _TG_API = False
        else:
            _TG_API = proc.returncode == 2 and "invalid API method" in (proc.stderr or "")
    return _TG_API


def tg_api(method: str, body: dict, *, with_chat: bool = False,
           quiet: bool = False, timeout: float = TG_API_TIMEOUT_SECS) -> dict | None:
    """Bot API `method` through `tg-notify --api`, killed after `timeout`
    seconds: the response object when it is ok, else None with a warning on
    stderr (none when `quiet`). None without a warning when tg-notify is
    missing or has no --api."""
    global _TG_API, _TG_MODE
    if _TG_API is False or _TG_MODE == "missing":
        return None
    cmd = [_tg_notify(), "--api", method, *(["--with-chat"] if with_chat else [])]
    try:
        proc = subprocess.run(cmd, input=json.dumps(body, ensure_ascii=False),
                              capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        _TG_MODE = "missing"
        _TG_API = False
        return None
    except (OSError, subprocess.TimeoutExpired) as exc:
        err = (str(exc) or type(exc).__name__)[:LAST_ERROR_MAX]
    else:
        if _unknown_flag(proc):
            _TG_API = False
            return None
        if proc.returncode != 0:
            err = _proc_error(proc)
        else:
            try:
                resp = json.loads(proc.stdout)
            except ValueError:
                resp = None
            if isinstance(resp, dict) and resp.get("ok"):
                return resp
            err = "response not ok"
    if not quiet:
        print(f"warning: telegram {method} failed: {err}", file=sys.stderr)
    return None


def load_tg_state() -> dict:
    """TG_STATE_FILE contents; missing or unreadable = {}."""
    try:
        data = json.loads(TG_STATE_FILE.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        print(f"warning: cannot read {TG_STATE_FILE}: {exc}", file=sys.stderr)
        return {}
    return data if isinstance(data, dict) else {}


def save_tg_state(state: dict) -> None:
    _write_json_atomic(TG_STATE_FILE, state)


def _tg_chat_id(state: dict) -> int | None:
    """Cached chat id in `state`, else learned through getChat and saved to
    TG_STATE_FILE under the lock, which the caller does not hold."""
    if isinstance(state.get("chat_id"), int):
        return state["chat_id"]
    resp = tg_api("getChat", {}, with_chat=True)
    result = resp.get("result") if resp else None
    cid = result.get("id") if isinstance(result, dict) else None
    if not isinstance(cid, int):
        return None
    with _reminders_locked():
        fresh = load_tg_state()
        fresh["chat_id"] = cid
        save_tg_state(fresh)
    return cid


def _clock(ts: float | None, now: float) -> str:
    """`HH:MM` on the day of `now`, else `DD Mon HH:MM`; `?` for None."""
    if ts is None:
        return "?"
    dt = datetime.fromtimestamp(ts)
    same_day = dt.date() == datetime.fromtimestamp(now).date()
    return dt.strftime("%H:%M" if same_day else "%d %b %H:%M")


def _tg_status(rem: dict, now: float) -> str:
    state = _reminder_state(rem)
    if state == "acked":
        return f"✅ acked {_clock(_iso_ts(rem.get('acked_at')), now)}"
    if state == "pending":
        return f"⏰ snoozed → {_clock(_iso_ts(rem.get('due')), now)}"
    return state


def tg_actions(rid: str) -> dict:
    """Inline keyboard with the TG_ACTIONS buttons for reminder `rid`."""
    return {"inline_keyboard": [[{"text": text, "callback_data": f"rem:{rid}:{action}"}
                                 for action, text, _ in TG_ACTIONS]]}


def tg_markup(rem: dict, now: float | None = None) -> dict:
    """Inline keyboard for a reminder's message: tg_actions while it is
    missed, one `unack` button showing its state once acked, one `unsnooze`
    button while pending with snoozed_from, else one `noop` button showing its
    state."""
    state = _reminder_state(rem)
    if state == "missed":
        return tg_actions(rem["id"])
    now = now if now is not None else time.time()
    if state == "acked":
        return {"inline_keyboard": [[{"text": f"{_tg_status(rem, now)} · ↩ undo",
                                      "callback_data": f"rem:{rem['id']}:unack"}]]}
    if state == "pending" and rem.get("snoozed_from"):
        return {"inline_keyboard": [[{"text": f"{_tg_status(rem, now)} · ↩ undo",
                                      "callback_data": f"rem:{rem['id']}:unsnooze"}]]}
    return {"inline_keyboard": [[{"text": _tg_status(rem, now),
                                  "callback_data": f"rem:{rem['id']}:noop"}]]}


def tg_update_buttons(rems: list[dict]) -> None:
    """Set each reminder's message buttons to tg_markup; ones without a
    tg_message_id are skipped, failures warn on stderr. Nothing happens when
    tg-notify is missing or has no --api."""
    now = time.time()
    rems = [r for r in rems if isinstance(r.get("tg_message_id"), int)]
    if not rems or not tg_api_supported():
        return
    for rem in rems:
        tg_api("editMessageReplyMarkup", {"message_id": rem["tg_message_id"],
                                          "reply_markup": tg_markup(rem, now)}, with_chat=True)


def _tg_callback(query: dict, rems: list[dict], now: float) -> tuple[str, dict | None]:
    """Apply a `rem:<id>:<action>` button press: (answer text, reminder whose
    buttons need an update or None). The caller holds the lock and saves."""
    parts = str(query.get("data") or "").split(":")
    mid = (query.get("message") or {}).get("message_id")
    rem = None
    if len(parts) == 3 and parts[0] == "rem" and isinstance(mid, int):
        rem = next((r for r in rems if r["id"] == parts[1]
                    and r.get("tg_message_id") == mid), None)
    if rem is None:
        return "unknown reminder", None
    action = parts[2]
    snooze = {a: secs for a, _, secs in TG_ACTIONS if secs}
    if action == "ack":
        if ack_reminder(rem, "telegram", now):
            print(f"acked {rem['id']} via telegram")
            return "acked", rem
        state = _reminder_state(rem)
        return ("already acked" if state == "acked" else state), rem
    if action == "unack":
        if unack_reminder(rem):
            print(f"unacked {rem['id']} via telegram")
            return "ack undone", rem
        return _reminder_state(rem), rem
    if action == "unsnooze":
        if unsnooze_reminder(rem):
            print(f"unsnoozed {rem['id']} via telegram")
            return "snooze undone", rem
        return _reminder_state(rem), rem
    if action in snooze:
        snooze_reminder(rem, now + snooze[action])
        print(f"snoozed {rem['id']} via telegram")
        return f"snoozed → {_clock(now + snooze[action], now)}", rem
    if action == "noop":
        return _tg_status(rem, now), None
    return "unknown reminder", None


def _tg_digest_callback(query: dict, rems: list[dict], state: dict,
                        now: float) -> tuple[str, list[dict], dict | None]:
    """Apply a press on the latest digest: (answer text, changed reminders,
    new digest buttons or None). `dig:ackall` acks the reminders it lists, in
    digest_ids, that are still missed, via "digest", and adds them to
    digest_acked_ids. `dig:undo` unacks the digest_acked_ids ones still acked
    via "digest", empties digest_acked_ids and restores DIGEST_MARKUP. The
    caller holds the lock and saves both files."""
    data = query.get("data")
    mid = (query.get("message") or {}).get("message_id")
    if data not in ("dig:ackall", "dig:undo") or not isinstance(mid, int):
        return "nothing to do", [], None
    if mid != state.get("digest_message_id"):
        return "old digest", [], None
    prior = list(state.get("digest_acked_ids") or [])
    if data == "dig:undo":
        listed = set(prior)
        undone = [r for r in rems if r["id"] in listed
                  and r.get("acked_via") == "digest" and unack_reminder(r)]
        if undone:
            print(f"unacked {', '.join(r['id'] for r in undone)} via digest")
        state["digest_acked_ids"] = []
        return f"undid {len(undone)}", undone, DIGEST_MARKUP
    listed = set(state.get("digest_ids") or [])
    acked = [r for r in rems if r["id"] in listed and ack_reminder(r, "digest", now)]
    if acked:
        print(f"acked {', '.join(r['id'] for r in acked)} via digest")
    ids = prior + [r["id"] for r in acked if r["id"] not in prior]
    state["digest_acked_ids"] = ids
    if ids:
        button = {"text": f"✅ acked {len(ids)} · ↩ undo", "callback_data": "dig:undo"}
    else:
        button = {"text": "✅ acked 0", "callback_data": "dig:noop"}
    return f"acked {len(acked)}", acked, {"inline_keyboard": [[button]]}


def tg_poll(timeout: int = 0) -> bool:
    """One round of button presses from the configured chat: getUpdates
    waits up to `timeout` seconds without holding the lock, then the presses
    are applied to the reminders under the lock (tg-state reloaded there, so
    digest fields written meanwhile survive), then answered and the touched
    messages' buttons updated. Returns False when the chat id or getUpdates
    failed. Errors go to stderr; offset advances past every fetched update."""
    chat_id = _tg_chat_id(load_tg_state())
    if chat_id is None:
        return False
    resp = tg_api("getUpdates", {
        "offset": int(load_tg_state().get("offset") or 0), "timeout": timeout,
        "allowed_updates": ["callback_query"]}, timeout=timeout + TG_POLL_GRACE_SECS)
    if resp is None:
        return False
    result = resp.get("result")
    updates = [u for u in result if isinstance(u, dict)
               and isinstance(u.get("update_id"), int)] if isinstance(result, list) else []
    if not updates:
        return True
    now = time.time()
    answers: list[tuple[str, str]] = []
    touched: list[dict] = []
    digest_edit = None
    with _reminders_locked():
        state = load_tg_state()
        offset = int(state.get("offset") or 0)
        rems = load_reminders()
        changed = False
        for upd in updates:
            if upd["update_id"] < offset:  # applied by an earlier poll
                continue
            try:
                if isinstance(query := upd.get("callback_query"), dict):
                    chat = ((query.get("message") or {}).get("chat") or {}).get("id")
                    if chat != chat_id:
                        continue
                    if str(query.get("data") or "").startswith("dig:"):
                        text, hits, markup = _tg_digest_callback(query, rems, state, now)
                        digest_edit = markup or digest_edit
                    else:
                        text, rem = _tg_callback(query, rems, now)
                        hits = [rem] if rem else []
                    answers.append((query.get("id"), text))
                else:
                    continue
            except Exception as exc:  # one bad update must not stall the offset
                print(f"warning: telegram update {upd['update_id']}: {exc!r}",
                      file=sys.stderr)
                continue
            changed = changed or bool(hits)
            touched = [r for r in touched if all(r is not h for h in hits)] + hits
        if changed:
            save_reminders(rems)
        state["chat_id"] = chat_id
        state["offset"] = max(offset, max(u["update_id"] for u in updates) + 1)
        save_tg_state(state)
    for qid, text in answers:
        tg_api("answerCallbackQuery", {"callback_query_id": qid, "text": text}, quiet=True)
    tg_update_buttons(touched)
    if digest_edit is not None:
        tg_api("editMessageReplyMarkup", {"message_id": state["digest_message_id"],
                                          "reply_markup": digest_edit}, with_chat=True)
    return True


def digest_window(now: float) -> float:
    """Start of the latest digest window at or before `now`: the last
    DIGEST_WEEKDAY at DIGEST_HOUR:00 local."""
    dt = datetime.fromtimestamp(now)
    start = (dt - timedelta(days=(dt.weekday() - DIGEST_WEEKDAY) % 7)).replace(
        hour=DIGEST_HOUR, minute=0, second=0, microsecond=0)
    if start > dt:
        start -= timedelta(days=7)
    return start.timestamp()


def digest_message(missed: list[dict]) -> str:
    """tg-notify --html text listing `missed`; body lines are escaped here,
    as in reminder_message."""
    def esc(text: str) -> str:
        return html.escape(text, quote=False)

    lines = [f"⏰ {len(missed)} missed reminder(s)"]
    for r in missed:
        due = _iso_ts(r.get("due"))
        stamp = datetime.fromtimestamp(due).strftime("%H:%M %d %b") if due else "?"
        note = " ".join(str(r.get("note") or "").split())
        repo = str(r.get("repo_label") or r.get("cwd") or "?")
        lines.append(f"• {esc(note)} · due {esc(stamp)} · {esc(repo)} · "
                     f"<code>{esc(r['id'])}</code>")
    return "\n".join(lines)


def tg_digest(now: float, *, force: bool = False) -> str:
    """Send the digest of missed reminders, oldest due first, when the
    digest window opened after digest_last (any time when `force`), and
    record digest_last, digest_message_id and digest_ids (digest_acked_ids
    emptied). Returns "sent",
    "none" (nothing missed), "waiting" (window not open yet), "failed"
    (retried next run; digest_last unchanged) or "missing" (tg-notify not
    found; nothing printed, digest_last unchanged). An older tg-notify gets
    the plain text without the Ack all button (digest_message_id None)."""
    with _reminders_locked():
        state = load_tg_state()
        last = _iso_ts(state.get("digest_last"))
        if not force and last is not None and last >= digest_window(now):
            return "waiting"
        missed = sorted((r for r in load_reminders() if _reminder_state(r) == "missed"),
                        key=lambda r: _iso_ts(r.get("due")) or 0.0)
        result = "none"
        if missed:
            sent = send_notification(digest_message(missed), level="warn",
                                     markup=DIGEST_MARKUP)
            if sent.missing:
                return "missing"
            if sent.error is not None:
                print(f"digest failed: {sent.error}", file=sys.stderr)
                return "failed"
            state["digest_message_id"] = sent.message_id
            state["digest_ids"] = [r["id"] for r in missed]
            state["digest_acked_ids"] = []
            result = "sent"
            print(f"sent digest ({len(missed)} missed)")
        state["digest_last"] = _iso_at(now)
        save_tg_state(state)
    return result


def _protect_for_reminder(sid: str, rid: str, note: str) -> None:
    """Flag the session with a `reminder <id>: <note>` note; a session that
    already has a flag keeps it and its note."""
    if sid in load_protected()["sessions"]:
        console.print(f"[dim]session {sid[:8]} already protected; note kept[/dim]")
        return
    try:
        cmd_protect(sid, project=None, note=f"reminder {rid}: {note}")
    except SystemExit:
        console.print(f"[yellow]warning:[/yellow] could not protect session "
                      f"{sid[:8]}; the reminder is saved")


def cmd_remind_add(note: str, due: float, *, session: str | None,
                   protect: bool, now: float) -> int:
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or None
    if session is not None:
        sid = _resolve_session(session, (r["id"] for r in session_index()))
    cwd = os.getcwd()
    rec = {"note": note, "due": _iso_at(due), "created": _iso_at(now),
           "session_id": sid, "cwd": cwd, "repo_label": _repo_label(cwd),
           "status": "pending", "fired_at": None, "cancelled_at": None,
           "attempts": 0, "last_error": None, "snoozed_from": None,
           **dict.fromkeys(ACK_FIELDS)}
    with _reminders_locked():
        rems = load_reminders()
        taken = {r["id"] for r in rems}
        rid = secrets.token_hex(3)
        while rid in taken:
            rid = secrets.token_hex(3)
        rems.append({"id": rid, **rec})
        save_reminders(rems)
    where = f"session {sid[:8]}" if sid else "no session"
    console.print(f"[green]reminder[/green] {rid}  due {_local(due)} "
                  f"({_relative(due, now)})  [dim]{where}[/dim]", highlight=False)
    if sid and protect:
        _protect_for_reminder(sid, rid, note)
    return 0


def cmd_remind_list(*, show: str, as_json: bool) -> int:
    """Reminders for `show` (see reminders_by_due) as a table or JSON."""
    from rich.markup import escape
    from rich.table import Table

    rems = reminders_by_due(show)
    if as_json:
        print(json.dumps([reminder_json(r) for r in rems], indent=2))
        return 0
    if not rems:
        console.print({"open": "no pending or missed reminders",
                       "missed": "no missed reminders", "all": "no reminders"}[show])
        return 0
    now = time.time()
    table = Table(title="reminders", title_justify="left")
    for col in ("id", "state", "due", "note", "session", "repo"):
        table.add_column(col, overflow="fold" if col == "note" else None,
                         no_wrap=col in ("id", "state", "due", "session"))
    for r in rems:
        ts = _iso_ts(r.get("due"))
        due = f"{_local(ts)} ({_relative(ts, now)})" if ts is not None else "?"
        state = _reminder_state(r)
        table.add_row(r["id"], "[red]MISSED[/red]" if state == "missed" else state,
                      due, escape(str(r.get("note") or "")),
                      (r.get("session_id") or "")[:8],
                      escape(str(r.get("repo_label") or r.get("cwd") or "")))
    console.print(table)
    return 0


def cmd_remind_ack(ident: str | None) -> int:
    """Ack one missed reminder (`ident` = id or prefix), or every missed one
    when `ident` is None, through ack_reminder; then tg_update_buttons."""
    now = time.time()
    with _reminders_locked():
        rems = load_reminders()
        if ident is None:
            acked = [r for r in rems if ack_reminder(r, "manual", now)]
            if not acked:
                console.print("no missed reminders")
                return 0
        else:
            rem = _find_reminder(rems, ident)
            if rem is None:
                return 1
            state = _reminder_state(rem)
            if state == "acked":
                console.print(f"{rem['id']} already acked {rem.get('acked_at')} "
                              f"via {rem.get('acked_via') or '?'}", highlight=False)
                return 0
            if not ack_reminder(rem, "manual", now):
                err_console.print(f"[red]{rem['id']} is {state}, not missed[/red]")
                return 1
            acked = [rem]
        save_reminders(rems)
    if ident is None:
        console.print(f"[green]acked[/green] {len(acked)} reminder(s): "
                      f"{', '.join(r['id'] for r in acked)}", highlight=False)
    else:
        console.print(f"[green]acked[/green] {acked[0]['id']}")
    tg_update_buttons(acked)
    return 0


def cmd_remind_rm(ident: str) -> int:
    """Cancel a pending reminder; its session stays protected."""
    with _reminders_locked():
        rems = load_reminders()
        rem = _find_reminder(rems, ident)
        if rem is None:
            return 1
        if rem.get("status") != "pending":
            console.print(f"[yellow]{rem['id']} is {rem.get('status')}, not pending[/yellow]")
            return 1
        rem.update(status="cancelled", cancelled_at=_now_iso(), snoozed_from=None)
        save_reminders(rems)
    console.print(f"[green]cancelled[/green] {rem['id']}")
    tg_update_buttons([rem])
    return 0


def snooze_reminder(rem: dict, due: float) -> None:
    """Due = `due`, back to pending, ack cleared; tg_message_id stays until it
    fires again. snoozed_from keeps the old due and fired_at when it was
    missed, else is None. The caller holds the lock and saves."""
    was = ({"due": rem.get("due"), "fired_at": rem.get("fired_at")}
           if _reminder_state(rem) == "missed" else None)
    rem.update(due=_iso_at(due), status="pending", fired_at=None,
               cancelled_at=None, attempts=0, last_error=None,
               acked_at=None, acked_via=None, snoozed_from=was)


def unsnooze_reminder(rem: dict) -> bool:
    """Put a pending reminder with snoozed_from back to missed with its old
    due and fired_at; False (record unchanged) unless it is pending with
    snoozed_from. The caller holds the lock and saves."""
    was = rem.get("snoozed_from")
    if _reminder_state(rem) != "pending" or not isinstance(was, dict):
        return False
    rem.update(due=was.get("due"), fired_at=was.get("fired_at"), status="fired",
               snoozed_from=None)
    return True


def cmd_remind_snooze(ident: str, secs: int) -> int:
    """Due = now + secs through snooze_reminder."""
    now = time.time()
    due = now + secs
    with _reminders_locked():
        rems = load_reminders()
        rem = _find_reminder(rems, ident)
        if rem is None:
            return 1
        snooze_reminder(rem, due)
        save_reminders(rems)
    console.print(f"[green]snoozed[/green] {rem['id']}  due {_local(due)} "
                  f"({_relative(due, now)})", highlight=False)
    tg_update_buttons([rem])
    return 0


def _prune_reminders(rems: list[dict], now: float) -> list[dict]:
    """Drop acked records REMIND_KEEP_DAYS after acked_at and cancelled ones
    REMIND_KEEP_DAYS after cancelled_at (else due); missed and pending ones
    stay."""
    cutoff = now - REMIND_KEEP_DAYS * 86400

    def keep(r: dict) -> bool:
        state = _reminder_state(r)
        if state == "acked":
            ts = _iso_ts(r.get("acked_at"))
        elif state == "cancelled":
            ts = _iso_ts(r.get("cancelled_at")) or _iso_ts(r.get("due"))
        else:
            return True
        return ts is None or ts >= cutoff

    return [r for r in rems if keep(r)]


def cmd_remind_dispatch() -> int:
    """Notify every due pending reminder: fired with its tg_message_id on
    success, else attempts+1 and last_error (retried on the next run). When
    tg-notify is missing, a due reminder is fired without a message
    (last_error TG_MISSING, so it shows as missed) and the exit code stays 0.
    Then tg_digest, whose errors do not change the exit code. Button presses
    are handled by `remind listen`. Silent when nothing is due and no digest
    went out."""
    if not REMINDERS_FILE.exists():
        return 0
    now = time.time()
    failed = False
    with _reminders_locked():
        rems = load_reminders()
        changed = False
        for rem in rems:
            due = _iso_ts(rem.get("due"))
            if rem.get("status") != "pending" or due is None or due > now:
                continue
            changed = True
            sent = send_notification(reminder_message(rem, now),
                                     markup=tg_actions(rem["id"]))
            if sent.missing:
                rem.update(status="fired", fired_at=_iso_at(time.time()),
                           last_error=sent.error, tg_message_id=None, snoozed_from=None)
                print(f"not sent {rem['id']}: {sent.error}; marked missed", file=sys.stderr)
            elif sent.error is None:
                rem.update(status="fired", fired_at=_iso_at(time.time()), last_error=None,
                           tg_message_id=sent.message_id, snoozed_from=None)
                print(f"sent {rem['id']}")
            else:
                failed = True
                rem["attempts"] = int(rem.get("attempts") or 0) + 1
                rem["last_error"] = sent.error
                print(f"failed {rem['id']} (attempt {rem['attempts']}): {sent.error}",
                      file=sys.stderr)
        kept = _prune_reminders(rems, now)
        if changed or len(kept) != len(rems):
            save_reminders(kept)
    tg_digest(now)
    return 1 if failed else 0


def cmd_remind_listen() -> int:
    """tg_poll with TG_POLL_TIMEOUT_SECS in a loop until SIGTERM or ctrl-c
    (exit 0). After a failed poll it sleeps LISTEN_BACKOFF_SECS[0], doubling
    up to LISTEN_BACKOFF_SECS[1]; a successful poll resets the delay. Exits
    0 at once when tg-notify is missing or has no --api."""
    def stop(signum, frame):
        raise KeyboardInterrupt

    if not tg_api_supported():
        print("tg-notify missing or without --api; button presses disabled",
              file=sys.stderr)
        return 0
    prev = signal.signal(signal.SIGTERM, stop)
    first, cap = LISTEN_BACKOFF_SECS
    delay = first
    try:
        while True:
            if tg_poll(TG_POLL_TIMEOUT_SECS):
                delay = first
                continue
            print(f"poll failed; retrying in {delay}s", file=sys.stderr)
            time.sleep(delay)
            delay = min(delay * 2, cap)
    except KeyboardInterrupt:
        return 0
    finally:
        signal.signal(signal.SIGTERM, prev)


def cmd_remind_digest(*, force: bool) -> int:
    """tg_digest now; `force` ignores the weekly window."""
    result = tg_digest(time.time(), force=force)
    if result == "none":
        console.print("no missed reminders")
    elif result == "waiting":
        console.print("digest already sent this week (--force to send anyway)")
    elif result == "missing":
        err_console.print(f"[red]{TG_MISSING}; no digest sent[/red]")
    return 1 if result in ("failed", "missing") else 0


def _remind_exe() -> str:
    """claude-as as found on PATH, else this file's real path."""
    found = shutil.which("claude-as")
    return os.path.abspath(found) if found else os.path.realpath(__file__)


def _remind_path() -> str:
    """PATH for the dispatcher: ~/.local/bin (tg-notify), the dirs of sops,
    uv and curl, then the system dirs."""
    dirs = [str(Path.home() / ".local" / "bin")]
    for tool in ("sops", "uv", "curl"):
        found = shutil.which(tool)
        if found:
            dirs.append(os.path.dirname(os.path.abspath(found)))
    dirs += ["/usr/local/bin", "/usr/bin", "/bin"]
    return ":".join(dict.fromkeys(dirs))


def remind_units(exe: str, path: str) -> dict[str, str]:
    """{unit file name: contents} for the dispatcher service, its timer and
    the listener service."""
    return {
        f"{REMIND_UNIT}.service": (
            "[Unit]\n"
            "Description=claude-as reminder dispatcher\n"
            "\n"
            "[Service]\n"
            "Type=oneshot\n"
            f"Environment=PATH={path}\n"
            f"ExecStart={exe} remind dispatch\n"),
        f"{REMIND_UNIT}.timer": (
            "[Unit]\n"
            "Description=Run the claude-as reminder dispatcher every minute\n"
            "\n"
            "[Timer]\n"
            "OnCalendar=*:*:00\n"
            "Persistent=true\n"
            "AccuracySec=10s\n"
            "\n"
            "[Install]\n"
            "WantedBy=timers.target\n"),
        f"{LISTEN_UNIT}.service": (
            "[Unit]\n"
            "Description=claude-as reminder button listener (Telegram long polling)\n"
            "\n"
            "[Service]\n"
            "Type=simple\n"
            f"Environment=PATH={path}\n"
            "Environment=PYTHONUNBUFFERED=1\n"
            f"ExecStart={exe} remind listen\n"
            "Restart=on-failure\n"
            "RestartSec=10\n"
            "\n"
            "[Install]\n"
            "WantedBy=default.target\n"),
    }


def _systemctl(*args: str) -> int:
    cmd = ["systemctl", "--user", *args]
    try:
        rc = subprocess.run(cmd).returncode
    except OSError as exc:
        console.print(f"[red]{' '.join(cmd)} failed:[/red] {exc}")
        return 1
    if rc != 0:
        console.print(f"[red]{' '.join(cmd)} exited {rc}[/red]")
    return rc


def remind_plists(exe: str, path: str) -> dict[str, bytes]:
    """{plist file name: contents} for the launchd dispatcher (every 60s, and
    at load) and the listener (restarted 10s after a failed exit)."""
    import plistlib

    def plist(label: str, args: list[str], env: dict, **extra) -> bytes:
        log = str(LAUNCHD_LOG_DIR / f"{label.rsplit('.', 1)[1]}.log")
        return plistlib.dumps({
            "Label": label,
            "ProgramArguments": [exe, *args],
            "EnvironmentVariables": env,
            "RunAtLoad": True,
            "StandardOutPath": log,
            "StandardErrorPath": log,
            **extra,
        })

    return {
        f"{REMIND_LABEL}.plist": plist(REMIND_LABEL, ["remind", "dispatch"],
                                       {"PATH": path}, StartInterval=60),
        f"{LISTEN_LABEL}.plist": plist(LISTEN_LABEL, ["remind", "listen"],
                                       {"PATH": path, "PYTHONUNBUFFERED": "1"},
                                       KeepAlive={"SuccessfulExit": False},
                                       ThrottleInterval=10),
    }


def _launchctl(*args: str, check: bool = True) -> int:
    """`launchctl` in the user's GUI domain; `check=False` hides failures
    (bootout of a job that is not loaded)."""
    cmd = ["launchctl", *args]
    try:
        proc = subprocess.run(cmd, capture_output=not check)
    except OSError as exc:
        console.print(f"[red]{' '.join(cmd)} failed:[/red] {exc}")
        return 1
    if check and proc.returncode != 0:
        console.print(f"[red]{' '.join(cmd)} exited {proc.returncode}[/red]")
    return proc.returncode


def _launchd_domain() -> str:
    return f"gui/{os.getuid()}"


def cmd_remind_install_launchd(*, uninstall: bool) -> int:
    domain = _launchd_domain()
    listener = f"{LISTEN_LABEL}.plist"
    for label in (REMIND_LABEL, LISTEN_LABEL):  # reload = bootout, bootstrap
        _launchctl("bootout", f"{domain}/{label}", check=False)
    if uninstall:
        for name in remind_plists("", ""):
            path = LAUNCH_AGENTS_DIR / name
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
                console.print(f"[green]removed[/green] {path}")
        return 0
    LAUNCH_AGENTS_DIR.mkdir(parents=True, exist_ok=True)
    LAUNCHD_LOG_DIR.mkdir(parents=True, exist_ok=True)
    plists = remind_plists(_remind_exe(), _remind_path())
    if not tg_api_supported():
        del plists[listener]
        console.print(f"[yellow]note:[/yellow] tg-notify missing or without --api; "
                      f"{LISTEN_LABEL} not installed (no button presses)")
        stale = LAUNCH_AGENTS_DIR / listener
        if stale.exists():
            stale.unlink()
            console.print(f"[green]removed[/green] {stale}")
    rc = 0
    for name, data in plists.items():
        path = LAUNCH_AGENTS_DIR / name
        path.write_bytes(data)
        console.print(f"[green]wrote[/green] {path}")
        rc = rc or _launchctl("bootstrap", domain, str(path))
    if rc == 0:
        console.print(f"[green]loaded[/green] {', '.join(plists)} "
                      f"(logs: {LAUNCHD_LOG_DIR})")
    return rc


def cmd_remind_install(*, uninstall: bool) -> int:
    if IS_MAC:
        return cmd_remind_install_launchd(uninstall=uninstall)
    timer = f"{REMIND_UNIT}.timer"
    listener = f"{LISTEN_UNIT}.service"
    if uninstall:
        _systemctl("disable", "--now", timer)  # fails harmlessly when not installed
        _systemctl("disable", "--now", listener)
        for name in remind_units("", ""):
            path = SYSTEMD_USER_DIR / name
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
                console.print(f"[green]removed[/green] {path}")
        return _systemctl("daemon-reload")
    SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
    units = remind_units(_remind_exe(), _remind_path())
    api = tg_api_supported()
    if not api:
        del units[listener]
        console.print(f"[yellow]note:[/yellow] tg-notify missing or without --api; "
                      f"{listener} not installed (no button presses)")
        stale = SYSTEMD_USER_DIR / listener
        if stale.exists():
            _systemctl("disable", "--now", listener)
            stale.unlink()
            console.print(f"[green]removed[/green] {stale}")
    for name, text in units.items():
        path = SYSTEMD_USER_DIR / name
        path.write_text(text)
        console.print(f"[green]wrote[/green] {path}")
    rc = _systemctl("daemon-reload") or _systemctl("enable", "--now", timer)
    if rc == 0:
        console.print(f"[green]enabled[/green] {timer} (dispatch every minute)")
        if api:
            rc = _systemctl("enable", "--now", listener) or _systemctl("restart", listener)
            if rc == 0:
                console.print(f"[green]enabled[/green] {listener} (button presses)")
    return rc


def _remind_add_main(args: list[str]) -> int:
    usage = ("[red]usage:[/red] claude-as remind add (--in DUR | --at WHEN) "
             "\\[--session ID] \\[--no-protect] NOTE...")
    opts: dict[str, str] = {}
    protect = True
    words: list[str] = []
    it = iter(args)
    for arg in it:
        if arg in ("--in", "--at", "--session"):
            val = next(it, None)
            if val is None:
                console.print(f"[red]{arg} needs a value[/red]")
                console.print(usage)
                return 2
            opts[arg] = val
        elif arg == "--no-protect":
            protect = False
        elif arg.startswith("-"):
            console.print(f"[red]unknown remind add option:[/red] {arg}")
            console.print(usage)
            return 2
        else:
            words.append(arg)
    note = " ".join(words).strip()
    if not note or ("--in" in opts) == ("--at" in opts):
        console.print(usage)
        return 2
    now = time.time()
    try:
        due = (now + parse_duration(opts["--in"]) if "--in" in opts
               else parse_when(opts["--at"], now))
    except ValueError as exc:
        console.print(f"[red]{exc}[/red]")
        return 2
    return cmd_remind_add(note, due, session=opts.get("--session"),
                          protect=protect, now=now)


def _remind_main(args: list[str], passthrough: list[str]) -> int:
    usage = ("[red]usage:[/red] claude-as remind "
             "add|list|ack|rm|snooze|digest|dispatch|listen ... "
             "| --install | --uninstall")
    if passthrough or not args:
        console.print(usage)
        return 2
    sub, rest = args[0], args[1:]
    if sub in ("--install", "--uninstall"):
        if rest:
            console.print(usage)
            return 2
        return cmd_remind_install(uninstall=sub == "--uninstall")
    if sub == "add":
        return _remind_add_main(rest)
    if sub == "list":
        if (any(a not in ("--all", "--missed", "--json") for a in rest)
                or {"--all", "--missed"} <= set(rest)):
            console.print("[red]usage:[/red] claude-as remind list "
                          "\\[--missed|--all] \\[--json]")
            return 2
        show = "all" if "--all" in rest else "missed" if "--missed" in rest else "open"
        return cmd_remind_list(show=show, as_json="--json" in rest)
    if sub == "ack":
        if len(rest) != 1 or (rest[0].startswith("-") and rest[0] != "--all"):
            console.print("[red]usage:[/red] claude-as remind ack <id>|--all")
            return 2
        return cmd_remind_ack(None if rest[0] == "--all" else rest[0])
    if sub == "rm":
        if len(rest) != 1:
            console.print("[red]usage:[/red] claude-as remind rm <id>")
            return 2
        return cmd_remind_rm(rest[0])
    if sub == "snooze":
        if len(rest) != 2:
            console.print("[red]usage:[/red] claude-as remind snooze <id> DUR")
            return 2
        try:
            secs = parse_duration(rest[1])
        except ValueError as exc:
            console.print(f"[red]{exc}[/red]")
            return 2
        return cmd_remind_snooze(rest[0], secs)
    if sub == "digest":
        if rest not in ([], ["--force"]):
            console.print("[red]usage:[/red] claude-as remind digest \\[--force]")
            return 2
        return cmd_remind_digest(force=bool(rest))
    if sub == "dispatch":
        if rest:
            console.print(usage)
            return 2
        return cmd_remind_dispatch()
    if sub == "listen":
        if rest:
            console.print(usage)
            return 2
        return cmd_remind_listen()
    console.print(usage)
    return 2


