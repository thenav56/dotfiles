#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "rich"]
# ///
"""claude-as — launch an interactive `claude` as one of the tracked accounts.

Each account in `config.yaml` has a dedicated `accounts/<email>/` dir that we
point `CLAUDE_CONFIG_DIR` at. Before
launching we set that dir up so the session behaves exactly like the normal
aliased `claude`:

  * symlink the shared config layers (settings sources, skills, agents,
    commands, themes, plugins, global memory) into the account dir,
  * symlink the work/history state (projects, sessions, history, …) to
    ~/.claude so conversation history and `--resume` are unified across
    accounts — backing up any pre-existing per-account copy first,
  * mark onboarding complete so the TUI skips its first-run wizard,
  * then `exec claude-custom` — which regenerates settings.json from the
    symlinked base+local and execs the real claude binary.

This tool does CONFIG SETUP ONLY, never auth. If an account isn't logged in it
prints the `claude auth login` command for that account dir.

Data dir: $CLAUDE_AS_HOME, else the ~/.config/claude-as/home symlink. It holds
`accounts/<email>/` and `config.yaml` (`users:`, optional `orchestrate_pool:`).

Usage:
  claude-as                       pick an account, launch
  claude-as -- --resume           pick an account, pass `--resume` to claude
  claude-as work@example.com      launch as that account
  claude-as work@… -- --resume    launch as that account, pass `--resume`
  claude-as default [-- args]     launch via the `default` symlink (see below)
  claude-as set-default <sel>     point `default` at another account
  claude-as get-default           print the current default account (or none)
  claude-as accounts [--json]     list accounts (email, label, creds, in_pool,
                                  default)
  claude-as search [--as <sel>] [--grep <pat>]
                   [--view all|active|protected|unprotected|reminders]
                   [--list|--json] [--force-resume] [query...]
                   [-- <claude args>]
                                  find an old session (fzf, newest first) and
                                  resume it in its original dir, as <sel> or
                                  as `default`; --grep keeps sessions whose
                                  transcript contains <pat> (rg, fixed string,
                                  case-insensitive); --list/--json print the
                                  index instead (query words filter rows);
                                  a running session is not resumed again
                                  unless --force-resume. fzf keys: ^j/^k
                                  down/up, ^s cycle view all -> active ->
                                  protected -> unprotected, ^p
                                  protect/unprotect (undo on a `↩` row), ^n
                                  protect with a note (typed on the tty;
                                  enter = save, esc/^c = cancel), ^r
                                  reminders view and back. --view reminders
                                  lists missed reminders, then pending ones by
                                  due (--list/--json too; no --grep); there
                                  enter resumes the reminder's session (no
                                  session: prints a `cd` hint, exit 1), ^a
                                  acks, ^x cancels, ^z snoozes 1h
  claude-as protect <id-prefix> [--note TEXT]
  claude-as protect --project <path> [--note TEXT]
                                  keep a session (or every session in <path>
                                  and below) past claude's cleanup: copies are
                                  archived in ~/.local/share/claude-as/protected
                                  on every launch/search, and restored when
                                  search resumes a session claude deleted
  claude-as protect --list        protected sessions, project rules and
                                  recently unprotected ones
  claude-as protect --undo [<id-prefix>|<path>]
                                  re-protect the most recently unprotected
                                  session/project (or the named one) with its
                                  original note and date
  claude-as unprotect <id-prefix>|--project <path> [--purge]
                                  drop the flag; --purge deletes the archive.
                                  The flag is remembered for --undo (newest
                                  50, at most 30 days)
  claude-as resume <id-prefix> [--as <sel>] [--force-resume] [-- <claude args>]
                                  resume one session without the picker (same
                                  dir change, archive restore and running
                                  check as search)
  claude-as backlog add --pid <pid> [--title T] [--note N] [--meta JSON]
                    [--no-kill]   put away the claude session running in
                                  <pid> or below: refused while it works or
                                  a Bash-tool shell runs; protects it, then
                                  stops it (SIGTERM, SIGKILL after 5s)
  claude-as backlog list [--json] backlog and bin (binned entries are purged
                                  after 7 days, with the protection the
                                  backlog added)
  claude-as backlog edit <id> [--title T] [--note N]
  claude-as backlog bin <id> [--reason deleted|resumed]
  claude-as backlog restore <id>  bin -> backlog
  claude-as backlog purge <id>    drop a binned entry now
  claude-as backlog resume <id> [--force-resume] [-- <claude args>]
                                  resume it as it was launched (plain claude,
                                  an account, or a CLAUDE_CONFIG_DIR), in its
                                  dir; the entry moves to the bin. Backlog
                                  commands print one JSON object
  claude-as remind add (--in DUR | --at WHEN) [--session ID] [--no-protect]
                   NOTE...        Telegram reminder (tg-notify) at a time. DUR
                                  30m/3h/2d/2w/1d12h; WHEN `YYYY-MM-DD HH:MM`
                                  or `HH:MM` (local). Session defaults to
                                  $CLAUDE_CODE_SESSION_ID and is protected
                                  unless --no-protect; the message carries
                                  `claude-as resume <id>`
  claude-as remind list [--missed|--all] [--json]
                                  pending + missed (fired, not acked);
                                  --missed only those, --all every record
  claude-as remind ack <id>|--all acknowledge a missed reminder (--all: every
                                  one); resuming its session does not ack
  claude-as remind rm <id>        cancel (the session stays protected)
  claude-as remind snooze <id> DUR
                                  due again in DUR (clears the ack)
  claude-as remind dispatch       send due reminders and the weekly digest
                                  (run by the timer)
  claude-as remind listen         apply Telegram button presses as they
                                  arrive (long polling; run by the listener
                                  service)
  claude-as remind --install|--uninstall
                                  systemd user timer running dispatch every
                                  minute and the listen service (only when
                                  tg-notify has --api; ~/.config/systemd/user).
                                  macOS: launchd agents in ~/Library/LaunchAgents
  claude-as --help

The selector (left of `--`) matches an exact email, an exact label, or a unique
case-insensitive substring of either. Everything right of `--` is passed
verbatim to claude.

`accounts --json` also reports the orchestration pool: config.yaml may declare
`orchestrate_pool:` (list or comma-separated string of selectors) — the
accounts an orchestrator is allowed to fail over to when one hits a rate
limit. Order = preference order. Unresolvable selectors warn and are skipped.

`default` is reserved: `accounts/default` is a symlink to one account dir.
`claude-as default` exports the symlink path (unresolved) as
CLAUDE_CONFIG_DIR, and claude re-reads credentials through it on every
request, so `set-default` moves running default sessions to another account
without a restart (background shells keep running). set-default links shared
state into every account dir, holds the current target's OAuth refresh lock
while flipping, and prints how many running sessions use `default`.

macOS: claude keeps tokens in the login Keychain, keyed by a hash of the
CLAUDE_CONFIG_DIR string, so `default` has its own Keychain item.
set-default (and every launch while `default` points at the account) copies
the newer tokens between that item and the account's item.
"""
from __future__ import annotations

import contextlib
import fcntl
import glob
import hashlib
import html
