def cmd_set_default(selector: str) -> int:
    """Point `default` at another account; running default sessions follow."""
    if selector == DEFAULT_NAME:
        console.print(f"[red]{DEFAULT_NAME!r} is not an account[/red] — pass an "
                      f"email, label, or substring")
        return 2
    users = load_users()
    labels = dict(users)
    email = resolve_selector(selector, users)
    if not creds_present(email):
        _not_logged_in(email)
        return 1
    try:
        old = current_default()
    except DefaultError as exc:
        console.print(f"[red]error:[/red] {exc}")
        return 1
    if old == email:
        console.print(f"already default: {_who(email, labels)}")
        return 0

    # Shared state must be linked in every dir before a flip: a running
    # default session writes transcripts/history into whichever dir it lands on.
    dirs = [account_dir(e) for e, _ in users]
    if old is not None and (accounts_root() / old).is_dir():
        old_dir = accounts_root() / old
        if old_dir not in dirs:
            dirs.append(old_dir)
    for cfg in dirs:
        reconcile_symlinks(cfg)

    def flip() -> None:
        # macOS: the `default` path has its own Keychain item, so the symlink
        # alone moves nothing; copy the new account's tokens in first.
        if IS_MAC:
            sync_default_keychain(email)
        flip_default(email)

    try:
        if old is not None and (accounts_root() / old).is_dir():
            with oauth_refresh_lock(accounts_root() / old):
                flip()
        else:
            flip()
    except (DefaultError, LockTimeout) as exc:
        console.print(f"[red]error:[/red] {exc}")
        return 1

    console.print(f"[green]default:[/green] {_who(old, labels)} → {_who(email, labels)}")
    push_usage_switch(email, default_link())
    n = count_default_sessions(default_link())
    console.print(f"{n} running session(s) use {DEFAULT_NAME} — they switch on "
                  f"their next API request")
    return 0


def cmd_accounts(as_json: bool) -> int:
    """List accounts with creds + orchestration-pool membership + default."""
    import json

    users = load_users()
    pool = orchestrate_pool(users)
    try:
        default = current_default()
    except DefaultError as exc:
