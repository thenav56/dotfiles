from rich.console import Console

console = Console()
err_console = Console(stderr=True)

CLAUDE_HOME = Path.home() / ".claude"

# macOS has no /proc, keeps claude's OAuth tokens in the login Keychain (not
# `.credentials.json`) and runs user jobs under launchd (not systemd). Tests
# flip this to exercise either branch on any host.
IS_MAC = sys.platform == "darwin"

# Shared config symlinked into each account dir. Source = realpath(~/.claude/X),
# target = <acct>/X. settings.json is GENERATED (by claude-custom), never linked.
# hooks/ is intentionally absent: settings reference it by absolute
# $HOME/.claude/hooks/... so it fires without a per-account copy.
ALLOW_LIST = [
    "settings.base.json",   # generator source
    "settings.local.json",  # generator source (skipped if missing/broken)
    "settings.host.json",   # generator source (skipped if missing/broken)
    "skills",               # skill discovery from the config dir
    "plugins",              # pi?
    "state",              # pi?
    "agents",               # custom subagent definitions
    "commands",             # custom slash commands
    "output-styles",        # custom output styles
    "themes",               # `theme: custom:auto-dual` lookup
    "plugins",              # enabled plugins load from the config dir
    "CLAUDE.md",            # global memory…
    "CLAUDE.local.md",      # …and its @imports
    "RTK.md",
]

# Work/history state we want UNIFIED across accounts: conversation history,
# resume state, prompt history, todos, plans, tasks. Symlinked to ~/.claude
# like ALLOW_LIST, but here claude may have already created a REAL per-account
# dir/file — reconcile backs that up (`<name>.bak-per-account`) before linking
# so no history is lost. Sharing means `--resume` works whatever account you
# launch as.
SHARE_LIST = [
    "projects",             # per-project conversation history
    "sessions",             # session state (--resume)
    "history.jsonl",        # prompt history
    "todos",                # per-session todo lists
    "shell-snapshots",      # captured shell env for bash tool
    "file-history",         # edit/undo history
    "plans",                # saved plans
    "tasks",                # background task state
    "paste-cache",          # large-paste cache
    "debug",                # --debug logs; a flipped `default` session keeps writing here
]

# Known per-account state / generated output / absolute-path-referenced things
# that must NEVER be symlinked. Anything in ~/.claude in none of ALLOW_LIST,
# SHARE_LIST, or this set triggers an "unclassified entry" warning so the lists
# stay honest as Claude Code evolves.
SKIP_LIST = {
    ".credentials.json", ".gitignore", ".last-cleanup", "backups", "cache",
    "CLAUDE.host.md",  # imported by absolute path @~/.claude/CLAUDE.host.md
    "CLAUDE.md.d",  # referenced by absolute path ~/.claude/CLAUDE.md.d/
    "daemon", "daemon.json", "daemon.lock", "daemon.log",
    "daemon.status.json", "feedback", "hooks", "jobs",
    "mcp-needs-auth-cache.json",
    "policy-limits.json", "policy-limits.json.signature.json",
    "policy-limits.json.stamp.json", "policy-limits.json.signature-iat.json",
    "remote-settings.json", "remote-settings.json.signature.json",
    "remote-settings.json.signature-iat.json", "remote-settings.json.synced-at",
    "session-env",
    "settings.json", "settings.json.bak", "stats-cache.json", "telemetry",
}

# `accounts/default` is a symlink to one account dir (relative target = the
# folder-email). Sessions launched via `claude-as default` get the symlink path
# itself as CLAUDE_CONFIG_DIR; claude reads `<dir>/.credentials.json` and
# `.claude.json` through that path on every request, so `set-default` moves
# running sessions to another account without a restart.
DEFAULT_NAME = "default"

# Claude's OAuth refresh lock: a mkdir-style lock (proper-lockfile semantics)
# in the config dir. The holder touches its mtime every 5s; older than 60s =
# stale. set-default holds it on the CURRENT target while flipping, so a token
# refresh in flight cannot save A's rotated refresh token into B's dir.
OAUTH_LOCK_NAME = ".oauth_refresh.lock"
OAUTH_LOCK_STALE_SECS = 60.0
OAUTH_LOCK_POLL_SECS = 0.5
OAUTH_LOCK_TIMEOUT_SECS = 70.0


# --- data dir ---------------------------------------------------------------

# The data dir holds `accounts/<email>/` and `config.yaml`. It comes from
# $CLAUDE_AS_HOME, else from the ~/.config/claude-as/home symlink.
HOME_ENV = "CLAUDE_AS_HOME"


def home_link() -> Path:
    return Path.home() / ".config" / "claude-as" / "home"


def find_home() -> Path | None:
    """The data dir, or None when neither $CLAUDE_AS_HOME nor the
    ~/.config/claude-as/home symlink is set."""
    env = os.environ.get(HOME_ENV)
    if env:
        return Path(env).expanduser().resolve()
    link = home_link()
    if link.exists():
        return link.resolve()
    return None


def as_home() -> Path:
    """The data dir; exits with setup instructions when it is not configured."""
    home = find_home()
    if home is None:
        raise SystemExit(
            f"claude-as: no data dir configured. Set ${HOME_ENV} to it, or "
            f"symlink it: ln -s /path/to/data {home_link()}\n"
            f"The data dir holds accounts/<email>/ and config.yaml.")
    return home


def accounts_root() -> Path:
    return as_home() / "accounts"


def account_dir(email: str) -> Path:
    """`accounts/<email>`, created when missing."""
    d = accounts_root() / email
    d.mkdir(parents=True, exist_ok=True)
    return d


def load_config() -> dict:
    import yaml

    path = as_home() / "config.yaml"
    try:
        with open(path) as fh:
            return yaml.safe_load(fh) or {}
    except FileNotFoundError:
        raise SystemExit(f"claude-as: missing {path}") from None


def parse_users(data) -> list[tuple[str, str | None]]:
    """Parse the config.yaml `users` into [(email, label-or-None), ...].

    Accepts either form:
      users:                       # mapping of label -> email
        Frontend: a@x.com
      users:                       # list of emails or {email, label} maps
        - b@x.com
        - {email: c@x.com, label: QA}
    Entries without an email are dropped; blank labels become None.
    """
    users = (data or {}).get("users")
    out = []
    if isinstance(users, dict):
        for label, email in users.items():
            email = str(email or "").strip()
            label = str(label or "").strip() or None
            if email:
                out.append((email, label))
    elif isinstance(users, list):
        for u in users:
            if isinstance(u, dict):
                email = str(u.get("email") or "").strip()
                raw_label = u.get("label")
                label = str(raw_label).strip() if raw_label else ""
            else:
                email = str(u).strip()
                label = ""
            if email:
                out.append((email, label or None))
    return out


# --- account selection ------------------------------------------------------

def creds_present(email: str) -> bool:
    """Cheap, no-network check: does the account have stored credentials?"""
    return has_credentials(accounts_root() / email)


def has_credentials(cfg: Path) -> bool:
    """`<cfg>/.credentials.json` exists, or (macOS) the Keychain holds the
    item claude keys by `cfg`. `cfg` must be the exact CLAUDE_CONFIG_DIR
    string claude gets: the Keychain name hashes it unresolved."""
    if (cfg / ".credentials.json").exists():
        return True
    return IS_MAC and keychain_has(cfg)


# --- macOS Keychain -----------------------------------------------------------
#
# On macOS claude stores OAuth tokens in the login Keychain: a generic password
# with account $USER and service `Claude Code-credentials`, plus
# `-<first 8 hex of sha256(CLAUDE_CONFIG_DIR)>` when CLAUDE_CONFIG_DIR is set.
# The hash is over the string as given (NFC, not resolved), so the `default`
# symlink path has its own item. `<dir>/.credentials.json` is only a fallback
# claude reads when the Keychain has no item (and deletes on its next write).
KEYCHAIN_SERVICE = "Claude Code-credentials"
# `security -i` reads one command line from stdin; claude falls back to argv
# above about 4 KiB, and so do we.
SECURITY_STDIN_MAX = 4000
SECURITY_TIMEOUT_SECS = 15


def keychain_service(config_dir: Path | str) -> str:
    """Keychain service name claude uses for CLAUDE_CONFIG_DIR=`config_dir`."""
    key = unicodedata.normalize("NFC", str(config_dir)).encode()
    return f"{KEYCHAIN_SERVICE}-{hashlib.sha256(key).hexdigest()[:8]}"


def keychain_account() -> str:
    """Keychain account name claude uses: $USER when it is a plain name."""
    user = os.environ.get("USER")
    if not user:
        import getpass
        try:
            user = getpass.getuser()
        except Exception:
            user = ""
    return user if re.fullmatch(r"[a-zA-Z0-9._-]+", user or "") else "claude-code-user"


def _security(args: list[str], stdin: str | None = None):
    """Run /usr/bin/security; the CompletedProcess, or None when it cannot run."""
    try:
        return subprocess.run(["security", *args], input=stdin, capture_output=True,
                              text=True, timeout=SECURITY_TIMEOUT_SECS)
    except (OSError, subprocess.TimeoutExpired):
        return None


def keychain_has(config_dir: Path | str) -> bool:
    """The item exists (attributes only: no secret read, no access prompt)."""
    proc = _security(["find-generic-password", "-a", keychain_account(),
                      "-s", keychain_service(config_dir)])
    return proc is not None and proc.returncode == 0


def keychain_read(config_dir: Path | str) -> str | None:
    """The item's secret (claude's credentials JSON), or None."""
    proc = _security(["find-generic-password", "-a", keychain_account(),
                      "-s", keychain_service(config_dir), "-w"])
    if proc is None or proc.returncode != 0:
        return None
    return proc.stdout.rstrip("\n") or None


def keychain_write(config_dir: Path | str, secret: str) -> bool:
    """Create or replace the item, the way claude does (hex via `security -i`
    so the secret stays off argv)."""
    acct, svc = keychain_account(), keychain_service(config_dir)
    hexed = secret.encode().hex()
    line = f'add-generic-password -U -a "{acct}" -s "{svc}" -X "{hexed}"\n'
    if len(line) <= SECURITY_STDIN_MAX:
        proc = _security(["-i"], stdin=line)
    else:
        proc = _security(["add-generic-password", "-U", "-a", acct, "-s", svc, "-X", hexed])
    return proc is not None and proc.returncode == 0


def read_credentials(cfg: Path) -> str | None:
    """Stored credentials JSON for `cfg`: the Keychain item, else the
    plaintext `.credentials.json` (claude's own read order on macOS)."""
    secret = keychain_read(cfg)
    if secret is not None:
        return secret
    try:
        return (cfg / ".credentials.json").read_text() or None
    except OSError:
        return None


def _creds_expiry(secret: str | None) -> int:
    """claudeAiOauth.expiresAt (ms) of a credentials JSON; -1 when unknown.
    A refresh moves it forward, so the larger one holds the newer tokens."""
    try:
        return int(json.loads(secret)["claudeAiOauth"]["expiresAt"])
    except Exception:
        return -1


def load_users():
    """config.yaml users minus the reserved `default` name (it is the symlink,
    never an account of its own)."""
    users = []
    for email, label in parse_users(load_config()):
        if email == DEFAULT_NAME:
            print(f"warning: config.yaml user {email!r} is reserved — skipped",
                  file=sys.stderr)
            continue
        users.append((email, label))
    return users


def match_selector(selector: str, users) -> str | list[str]:
    """Match a selector against users. Returns the folder-email on a unique
    match, else the (possibly empty) list of candidate emails."""
    for email, _label in users:
        if email == selector:
            return email
    for email, label in users:
        if label and label == selector:
            return email
    needle = selector.lower()
    matches = [
        email for email, label in users
        if needle in email.lower() or (label and needle in label.lower())
    ]
    if len(matches) == 1:
        return matches[0]
    return matches


def resolve_selector(selector: str, users) -> str:
    """Resolve a selector to a folder-email. Exits on no/ambiguous match."""
    got = match_selector(selector, users)
    if isinstance(got, str):
        return got
    if got:
        console.print(f"[red]ambiguous selector[/red] {selector!r} matches:")
        for email in got:
            console.print(f"  {email}")
        raise SystemExit(2)
    console.print(f"[red]unknown account:[/red] {selector!r}")
    console.print("Run [bold]claude-as[/bold] with no selector to pick from the list.")
    raise SystemExit(2)


def orchestrate_pool(users) -> list[str]:
    """Resolve config.yaml `orchestrate_pool` to an ordered list of emails.

    Accepts a YAML list or comma-separated string of selectors. Unresolvable
    or ambiguous entries warn on stderr and are skipped — the pool must never
    silently widen. Empty/absent -> [] (orchestrators must then ask the user).
    """
    spec = load_config().get("orchestrate_pool")
    if spec is None:
        raw = []
    elif isinstance(spec, str):
        raw = spec.split(",")
    elif isinstance(spec, (list, tuple)):
        raw = list(spec)
    else:
        print(f"warning: orchestrate_pool has unexpected type {type(spec).__name__}",
              file=sys.stderr)
        raw = []
    out: list[str] = []
    for tok in raw:
        tok = str(tok).strip()
        if not tok:
            continue
        if tok == DEFAULT_NAME:
            print(f"warning: orchestrate_pool selector {tok!r} is the default "
                  f"symlink, not an account — skipped", file=sys.stderr)
            continue
        got = match_selector(tok, users)
        if isinstance(got, str):
            if got not in out:
                out.append(got)
        elif got:
            print(f"warning: orchestrate_pool selector {tok!r} is ambiguous "
                  f"({', '.join(got)}) — skipped", file=sys.stderr)
        else:
            print(f"warning: orchestrate_pool selector {tok!r} matches no account "
                  f"— skipped", file=sys.stderr)
    return out


def _marker(email: str) -> str:
    return "[green]✓ creds[/green]" if creds_present(email) else "[red]✗ creds[/red]"


def pick_account(users) -> str:
    """Interactive picker: fzf if available, numbered menu otherwise."""
    if not users:
        raise SystemExit("no accounts configured in config.yaml")

    if shutil.which("fzf"):
        # First tab-field is the email (the key, hidden via --with-nth=2..).
        lines = []
        for email, label in users:
            cred = "✓ creds" if creds_present(email) else "✗ creds"
            lines.append(f"{email}\t{label or email}\t[{cred}]")
        proc = subprocess.run(
            ["fzf", "--prompt=claude-as ❯ ", "--height=~40%", "--reverse",
             "--delimiter=\t", "--with-nth=2.."],
            input="\n".join(lines), capture_output=True, text=True,
        )
        if proc.returncode != 0 or not proc.stdout.strip():
            raise SystemExit("no account selected")
        return proc.stdout.strip().split("\t", 1)[0]

    # Numbered-menu fallback (SSH/plain-TTY safe).
    console.print("[bold]Select an account:[/bold]")
    for i, (email, label) in enumerate(users, 1):
        name = label or email
        console.print(f"  [cyan]{i}[/cyan]) {name}  [dim]<{email}>[/dim]  {_marker(email)}")
    raw = input(f"Number [1-{len(users)}]: ").strip()
    try:
        idx = int(raw)
        if not 1 <= idx <= len(users):
            raise ValueError
    except ValueError:
        raise SystemExit(f"invalid selection: {raw!r}")
    return users[idx - 1][0]


# --- setup steps ------------------------------------------------------------

def _link(name: str, cfg: Path, *, backup: bool) -> None:
    """Point cfg/name at realpath(~/.claude/name) via a symlink.

    Skips a missing/broken source. Replaces a wrong symlink atomically. When
    the target is already a REAL file/dir: if `backup`, rename it to
    `<name>.bak-per-account` (never overwriting an earlier backup) then link;
    otherwise leave it and warn (ALLOW_LIST config should never be per-account).
    """
    src = CLAUDE_HOME / name
    if not src.exists():  # follows symlinks: broken/missing source -> skip
        return
    real = src.resolve()
    target = cfg / name

    if target.is_symlink():
        if target.resolve() == real:
            return  # already correct
        # Wrong target: replace atomically.
        tmp = cfg / f".{name}.lnk-tmp"
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        os.symlink(real, tmp)
        os.replace(tmp, target)
        console.print(f"[yellow]relinked[/yellow] {name}")
    elif target.exists():
        if not backup:
            console.print(
                f"[yellow]warning:[/yellow] {target} is a real file/dir, not a "
                f"symlink — leaving it untouched (expected → {real})")
            return
        bak = cfg / f"{name}.bak-per-account"
        n = 1
        while bak.is_symlink() or bak.exists():
            bak = cfg / f"{name}.bak-per-account.{n}"
            n += 1
        os.rename(target, bak)
        os.symlink(real, target)
        console.print(f"[yellow]backed up[/yellow] {name} → {bak.name}, then linked")
    else:
        os.symlink(real, target)


def reconcile_symlinks(cfg: Path) -> None:
    """Symlink shared config + unified work/history state into the account dir.

    ALLOW_LIST = shared config (never expected to exist per-account). SHARE_LIST
    = work/history state claude may already have materialised per-account, so
    those get backed up before the first link.
    """
    for name in ALLOW_LIST:
        _link(name, cfg, backup=False)
    for name in SHARE_LIST:
        _link(name, cfg, backup=True)


def warn_unclassified() -> None:
    """Flag ~/.claude entries that are in neither ALLOW_LIST nor SKIP_LIST."""
    known = set(ALLOW_LIST) | set(SHARE_LIST) | SKIP_LIST
    try:
        entries = sorted(os.listdir(CLAUDE_HOME))
    except OSError:
        return
    for entry in entries:
        if entry not in known:
            console.print(
                f"[yellow]warning:[/yellow] unclassified entry in ~/.claude: "
                f"[bold]{entry}[/bold] — add it to ALLOW_LIST or SKIP_LIST in claude-as")


def ensure_onboarding(cfg: Path) -> None:
    """Set hasCompletedOnboarding=true in the account's .claude.json.

    Without it an interactive launch starts at the first-run wizard even though
    the stored token is valid. Atomic, 0600-preserving write (the file holds
    the oauthAccount identity and must not become world-readable).
    """
    import json

    path = cfg / ".claude.json"
    if not path.exists():
        console.print("[dim]note:[/dim] no .claude.json yet — claude will run its "
                      "first-run wizard once, then this is set automatically next time")
        return
    try:
        with open(path) as fh:
            data = json.load(fh)
    except Exception as exc:
        console.print(f"[yellow]warning:[/yellow] cannot read .claude.json: {exc}")
        return
    if data.get("hasCompletedOnboarding") is True:
        return
    data["hasCompletedOnboarding"] = True
    tmp = path.with_suffix(".json.tmp")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, indent=2)
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    except Exception as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        console.print(f"[yellow]warning:[/yellow] could not set onboarding flag: {exc}")


def login_cmd(email: str) -> str:
    """Shell command that logs `email` in to its own account dir."""
    cfg = shlex.quote(str(accounts_root() / email))
    return (f"CLAUDE_CONFIG_DIR={cfg} claude auth login --claudeai "
            f"--email {shlex.quote(email)}")


def _not_logged_in(email: str) -> None:
    where = "no Keychain item or .credentials.json" if IS_MAC else "no .credentials.json"
    console.print(f"[red]not logged in:[/red] {email} has {where}")
    console.print(f"Log in first: [bold]{login_cmd(email)}[/bold]", soft_wrap=True)


def auth_gate(cfg: Path, email: str) -> None:
    """Abort (with a pointer) if the account has no stored credentials."""
    if has_credentials(cfg):
        return
    _not_logged_in(email)
    raise SystemExit(1)


def launch(email: str, passthrough: list[str], config_dir: Path | None = None) -> None:
    """Set up the account's real dir, then exec claude.

    `config_dir` is what CLAUDE_CONFIG_DIR gets (the unresolved `default`
    symlink path for `claude-as default`); setup always runs on the real
    account dir.
    """
    cfg = account_dir(email)          # ensures the dir exists
    auth_gate(cfg, email)
    reconcile_symlinks(cfg)
    warn_unclassified()
    ensure_onboarding(cfg)
    if IS_MAC:
        _sync_default_before_launch(email, via_default=config_dir is not None)

    _sync_quietly()

    wrapper = shutil.which("claude-custom")
    if not wrapper:
        raise SystemExit("claude-custom not found on PATH (needed to regenerate "
                         "settings.json and launch the real claude)")
    env = dict(os.environ)
    env["CLAUDE_CONFIG_DIR"] = str(config_dir if config_dir is not None else cfg)
    if config_dir is not None:
        console.print(f"[green]launching[/green] claude as [bold]{DEFAULT_NAME}[/bold] "
                      f"→ [bold]{email}[/bold]")
    else:
        console.print(f"[green]launching[/green] claude as [bold]{email}[/bold]")
    os.execve(wrapper, [wrapper, *passthrough], env)


# --- default account --------------------------------------------------------

class DefaultError(Exception):
    """`accounts/default` is in a state set-default must not touch."""


class LockTimeout(Exception):
    """Claude's OAuth refresh lock stayed held past the timeout."""


def default_link(accounts_dir: Path | None = None) -> Path:
    """Path of the `default` symlink (never resolved)."""
    return (accounts_dir or accounts_root()) / DEFAULT_NAME


def current_default(accounts_dir: Path | None = None) -> str | None:
    """Folder-email `default` points at, or None when there is no symlink.

    Raises DefaultError when `default` exists but is not a symlink.
    """
    link = default_link(accounts_dir)
    if link.is_symlink():
        return Path(os.readlink(link)).name
    if link.exists():
        raise DefaultError(f"{link} is a real file/dir, not a symlink — "
                           f"move it aside by hand")
    return None


def flip_default(email: str, accounts_dir: Path | None = None) -> None:
    """Atomically point `default` at `email` (relative target).

    Builds `default.tmp-<pid>` then renames it over `default` (`ln -sfn` +
    `mv -T`), so readers see either the old or the new target, never a gap.
    Refuses to replace a real file/dir.
    """
    accounts_dir = accounts_dir or accounts_root()
    link = default_link(accounts_dir)
    if link.exists() and not link.is_symlink():
        raise DefaultError(f"{link} is a real file/dir, not a symlink — "
                           f"move it aside by hand")
    if not (accounts_dir / email).is_dir():
        raise DefaultError(f"account dir missing: {accounts_dir / email}")
    tmp = accounts_dir / f"{DEFAULT_NAME}.tmp-{os.getpid()}"
    if tmp.is_symlink():
        tmp.unlink()
    os.symlink(email, tmp)
    try:
        os.replace(tmp, link)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


@contextlib.contextmanager
def oauth_refresh_lock(cfg: Path, *, timeout: float = OAUTH_LOCK_TIMEOUT_SECS,
                       poll: float = OAUTH_LOCK_POLL_SECS,
                       stale: float = OAUTH_LOCK_STALE_SECS):
    """Hold claude's `<cfg>/.oauth_refresh.lock` (mkdir lock) for the block.

    A held lock is waited on (every `poll`s, up to `timeout`s, then
    LockTimeout); one whose mtime is older than `stale`s is taken over.
    """
    lock = cfg / OAUTH_LOCK_NAME
    deadline = time.monotonic() + timeout
    while True:
        try:
            os.mkdir(lock)
            break
        except FileExistsError:
            pass
        try:
            age = time.time() - lock.stat().st_mtime
        except FileNotFoundError:
            continue  # released between mkdir and stat
        if age > stale:
            with contextlib.suppress(FileNotFoundError):
                os.rmdir(lock)
            console.print(f"[yellow]took over stale lock[/yellow] {lock} "
                          f"({age:.0f}s old)")
            continue
        if time.monotonic() >= deadline:
            raise LockTimeout(f"{lock} still held after {timeout:.0f}s — a token "
                              f"refresh may be stuck; retry later")
        time.sleep(poll)
    try:
        yield lock
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.rmdir(lock)


# macOS: which account's tokens the `default` Keychain item holds (one email),
# so set-default can save a refresh made through `default` back to that
# account before overwriting the item.
DEFAULT_OWNER_FILE = ".default-keychain-owner"


def sync_default_keychain(target: str | None) -> None:
    """macOS: make the `default` Keychain item hold `target`'s newest tokens.

    `default` and `<target>` are two Keychain items with the same tokens, and
    claude refreshes whichever one its session uses. First, when the item's
    owner (DEFAULT_OWNER_FILE) has older tokens than it, they are written back
    to the owner. Then the target's tokens (or the item's own, when it already
    belongs to the target and is newer) are written to the `default` item.
    Newer = later claudeAiOauth.expiresAt. Raises DefaultError on a failed
    write or when the target has no credentials. Run it under the current
    target's OAuth refresh lock.
    """
    root = accounts_root()
    dflt = default_link(root)
    marker = as_home() / DEFAULT_OWNER_FILE
    try:
        owner = marker.read_text().strip() or None
    except OSError:
        owner = None
    cur = keychain_read(dflt)
    if owner and cur is not None and (root / owner).is_dir():
        theirs = read_credentials(root / owner)
        if cur != theirs and _creds_expiry(cur) > _creds_expiry(theirs):
            if not keychain_write(root / owner, cur):
                raise DefaultError(f"could not save {DEFAULT_NAME}'s refreshed tokens "
                                   f"back to {owner}'s Keychain item")
    if target is None:
        return
    new = read_credentials(root / target)
    if owner == target and cur is not None and _creds_expiry(cur) > _creds_expiry(new):
        new = cur
    if new is None:
        raise DefaultError(f"{target} has no stored credentials")
    if new != cur and not keychain_write(dflt, new):
        raise DefaultError(f"could not write {target}'s tokens to the "
                           f"{DEFAULT_NAME} Keychain item")
    if owner != target:
        marker.write_text(target + "\n")


def _sync_default_before_launch(email: str, *, via_default: bool) -> None:
    """macOS: when `default` points at `email`, sync the two Keychain items
    before launching through either path, so neither starts on tokens the
    other has already rotated. Only a launch through `default` aborts on
    failure; a direct launch warns."""
    try:
        if current_default() != email:
            return
        with oauth_refresh_lock(accounts_root() / email):
            sync_default_keychain(email)
    except (DefaultError, LockTimeout) as exc:
        console.print(f"[{'red' if via_default else 'yellow'}]Keychain sync:[/] {exc}")
        if via_default:
            raise SystemExit(1)


def count_default_sessions(default_path: Path, proc_root: Path = Path("/proc")) -> int:
    """Count running sessions whose CLAUDE_CONFIG_DIR is `default_path`.

    Compares the normalised, unresolved string (a trailing slash matches).
    Child processes (tool shells, MCP servers) inherit the env, so only
    matching processes whose parent does not match are counted.
    """
    return len(_default_session_pids(default_path, proc_root))


def _default_session_pids(default_path: Path, proc_root: Path = Path("/proc")) -> list[str]:
    """Pids of the sessions count_default_sessions counts."""
    want = os.path.normpath(str(default_path))
    procs = _mac_config_dir_procs() if IS_MAC else _proc_config_dir_procs(proc_root)
    matched = {pid: ppid for pid, ppid, val in procs
               if val and os.path.normpath(val) == want}
    return [pid for pid, ppid in matched.items() if ppid not in matched]


def default_session_terminals(default_path: Path, proc_root: Path = Path("/proc")) -> list[str]:
    """herdr terminals ($HC_TERMINAL_ID) of running sessions on `default_path`."""
    out = set()
    for pid in _default_session_pids(default_path, proc_root):
        try:
            env = _mac_proc_environ(int(pid)) if IS_MAC else Path(proc_root, pid, "environ").read_bytes().split(b"\0")
        except Exception:
            env = None
        for var in env or ():
            if var.startswith(b"HC_TERMINAL_ID="):
                out.add(var.split(b"=", 1)[1].decode(errors="replace"))
                break
    return sorted(t for t in out if t)


def push_usage_switch(email: str, default_path: Path) -> None:
    """Relabel the herdr terminals of running default sessions at once, so the
    agents sidebar shows the new account without waiting for each session's next
    request and status-line redraw (commands/agent-usage-publish). Best effort."""
    publisher = Path(__file__).resolve().parent / "agent-usage-publish"
    terms = default_session_terminals(default_path)
    if not terms or not publisher.exists():
        return
    try:
        subprocess.run([sys.executable, str(publisher), "claude-switch", email, *terms],
                       capture_output=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _proc_config_dir_procs(proc_root: Path) -> list[tuple[str, str | None, str]]:
    """(pid, ppid, CLAUDE_CONFIG_DIR) for each /proc process that sets it."""
    out = []
    try:
        entries = list(os.scandir(proc_root))
    except OSError:
        return out
    for entry in entries:
        if not entry.name.isdigit():
            continue
        try:
            raw = Path(entry.path, "environ").read_bytes()
        except OSError:
            continue
        for var in raw.split(b"\0"):
            if var.startswith(b"CLAUDE_CONFIG_DIR="):
                val = var.split(b"=", 1)[1].decode(errors="replace")
                out.append((entry.name, _ppid(Path(entry.path)), val))
                break
    return out


def _ps(args: list[str]) -> str:
    """`ps` output (TZ=UTC, C locale: the `lstart` format claude records on
    macOS as procStart); empty on failure."""
    env = {**os.environ, "TZ": "UTC", "LC_ALL": "C"}
    try:
        return subprocess.run(["ps", *args], capture_output=True, text=True,
                              env=env, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def _mac_proc_environ(pid: int) -> list[bytes] | None:
    """Environment of `pid` via sysctl KERN_PROCARGS2 (works for the user's
    own processes; `ps e` hides it on current macOS). None when unreadable."""
    import ctypes
    import ctypes.util

    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    mib = (ctypes.c_int * 3)(1, 49, pid)  # CTL_KERN, KERN_PROCARGS2
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0:
        return None
    buf = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
        return None
    return _parse_procargs2(buf.raw[:size.value])


def _parse_procargs2(raw: bytes) -> list[bytes] | None:
    """Env strings from a KERN_PROCARGS2 buffer: int argc, exec path, NUL
    padding, argc argv strings, env strings, an empty string, apple strings."""
    if len(raw) < 4:
        return None
    argc = int.from_bytes(raw[:4], sys.byteorder)
    pos = raw.find(b"\0", 4)
    if pos < 0:
        return None
    while pos < len(raw) and raw[pos] == 0:
        pos += 1
    env = []
    for item in raw[pos:].split(b"\0")[argc:]:
        if not item:
            break
        env.append(item)
    return env


def _mac_config_dir_procs() -> list[tuple[str, str | None, str]]:
    """(pid, ppid, CLAUDE_CONFIG_DIR) for each readable process that sets it."""
    out = []
    for line in _ps(["-axo", "pid=,ppid="]).splitlines():
        parts = line.split()
        if len(parts) != 2 or not parts[0].isdigit():
            continue
        try:
            env = _mac_proc_environ(int(parts[0]))
        except Exception:
            env = None
        for var in env or ():
            if var.startswith(b"CLAUDE_CONFIG_DIR="):
                out.append((parts[0], parts[1], var.split(b"=", 1)[1].decode(errors="replace")))
                break
    return out


def _ppid(proc_dir: Path) -> str | None:
    """Parent pid from /proc/<pid>/stat (field after the `(comm)`)."""
    try:
        stat = (proc_dir / "stat").read_text()
        return stat.rsplit(")", 1)[1].split()[1]
    except (OSError, IndexError):
        return None


def _who(email: str | None, labels: dict[str, str | None]) -> str:
    if email is None:
        return "[dim]none[/dim]"
    label = labels.get(email)
    return f"[bold]{label}[/bold] [dim]<{email}>[/dim]" if label else f"[bold]{email}[/bold]"


